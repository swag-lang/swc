# Unit tests anchor `swc-expected-error` / `swc-expected-warning` markers to
# the exact line that raises the diagnostic: any option that adds, removes, or
# moves lines would detach a marker from its error. Only the line-count-stable
# rewrites (spacing, alignment, literal case, ...) stay inherited from the
# repository `.swc-format`. The lexer/ and parser/ suites keep their own stricter
# all-preserve overrides on top of this one.
allow-short-functions-on-single-line = preserve
allow-short-blocks-on-single-line = preserve
allow-short-enums-on-single-line = preserve
allow-short-structs-on-single-line = preserve
allow-short-if-statements-on-single-line = preserve
allow-short-loops-on-single-line = preserve
case-body-style = preserve
blank-line-between-cases = preserve
allow-short-closures-on-single-line = preserve
remove-redundant-semicolons = preserve
remove-condition-parentheses = preserve
one-statement-per-line = preserve
one-enum-value-per-line = preserve
one-struct-field-per-line = preserve
break-before-where = preserve
bin-pack-arguments = preserve
bin-pack-parameters = preserve
force-single-line-argument-lists = preserve
force-single-line-parameter-lists = preserve
source-selects-argument-layout = preserve
source-selects-parameter-layout = preserve
argument-list-layout = preserve
parameter-list-layout = preserve
hug-trailing-block-argument = preserve
hug-trailing-block-item = preserve
bin-pack-literal-items = preserve
force-single-line-literal-lists = preserve
source-selects-literal-layout = preserve
literal-list-layout = preserve
force-single-line-logical-expressions = preserve
source-selects-logical-expression-layout = preserve
logical-expression-layout = preserve
logical-operator-break-position = preserve
logical-operand-packing = preserve
sort-using-statements = preserve
merge-using-statements = preserve
blank-line-after-using-block = preserve
blank-line-after-global-block = preserve
trim-leading-blank-lines = preserve
blank-line-after-opening-brace = preserve
blank-line-before-closing-brace = preserve
blank-line-before-function-definition = preserve
blank-line-before-type-definition = preserve
blank-line-before-comment-block = preserve
blank-line-after-standalone-closing-brace = preserve
