const CtxCbfLuma                   = 30'u32
const CtxCbfChroma                 = 32'u32
const CtxCbfChroma422              = 36'u32
const CtxAbsMvdGreater0Flag        = 37'u32
const CtxAbsMvdGreater1Flag        = 38'u32
