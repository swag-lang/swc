#import("gui", location: "swag@std")
#load("surface.swg")
#load("calc.symbols.swg")

using Core, Gui, Pixel, Core.Math

late var g_Edit:    *EditBox
var g_ComputeValue: s64
var g_CurValue:     s64
var g_Op:           String
var g_Error:        string?
var g_Start:        bool = true

func enter(str: string)
{
    if str == "Clear"
    {
        g_ComputeValue = 0
        g_CurValue     = 0
        g_Op.clear()
        g_Error = null
        g_Start = true
    }
    elif Latin1.isDigit(str[0])
    {
        if g_Start
        {
            g_CurValue = 0
            g_Start    = false
            g_Error    = null
        }

        let v = expect StrConv.toS64(str)
        g_CurValue = (g_CurValue * 10) + v
    }
    else
    {
        switch cast(string, g_Op)
        {
        case "+":
            g_ComputeValue += g_CurValue

        case "-":
            g_ComputeValue -= g_CurValue

        case Mul:
            g_ComputeValue *= g_CurValue

        case Div:
            if g_CurValue == 0 do
                g_Error = "divide by zero"
            else do
                g_ComputeValue /= g_CurValue

        default:
            g_ComputeValue = g_CurValue
        }

        g_Start    = true
        g_CurValue = g_ComputeValue
        g_Op       = str
    }

    let edit = g_Edit
    if g_Error do
        edit.setText(unwrap g_Error)
    else do
        edit.setText(Format.toString("%", g_CurValue))
}

func addKey(layout: *GridLayoutCtrl, text: string, column, row: s32, span = 1)
{
    let form        = text == "=" ? PushButtonForm.Strong : PushButtonForm.Normal
    with let button = PushButton.create(layout, text, form: form)
    {
        .style.setFont(layout.theme().createDefaultFont(text == "Clear" ? 17 : 26), .Regular)
        .sigPressed += func|text|(_) { enter(text) }
    }

    layout.setCell(button, column, row, span)
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    if evt is CreateEvent
    {
        with let layout = GridLayoutCtrl.create(wnd, 4, 6)
        {
            .dockStyle       = .Center
            .flags           = .EqualColumnWidths | .EqualRowHeights
            .backgroundStyle = .Window
            .margin          = 16
        }

        with g_Edit = EditBox.create(layout, "0", flags: .ReadOnly | .RightAligned)
        {
            .style.setFont(wnd.theme().createDefaultFont(30), .Regular)
        }

        layout.setCell(g_Edit, 0, 0, 4)

        addKey(layout, "7", 0, 2)
        addKey(layout, "8", 1, 2)
        addKey(layout, "9", 2, 2)
        addKey(layout, "4", 0, 3)
        addKey(layout, "5", 1, 3)
        addKey(layout, "6", 2, 3)
        addKey(layout, "1", 0, 4)
        addKey(layout, "2", 1, 4)
        addKey(layout, "3", 2, 4)
        addKey(layout, "0", 0, 5, 3)

        addKey(layout, "Clear", 0, 1, 3)
        addKey(layout, Div, 3, 1)
        addKey(layout, Mul, 3, 2)
        addKey(layout, "-", 3, 3)
        addKey(layout, "+", 3, 4)
        addKey(layout, "=", 3, 5)

        layout.computeLayout()
    }

    return false
}

#main
{
    try runExample(354, 369, title: "Calculator", hook: &onEvent, canSize: false)
}
