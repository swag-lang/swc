#global private

#assert(1.5575 == 1.5575)
#assert(-1.5575 == -1.5575)
#assert(1.5575_f32 == 1.5575_f32)
#assert(1.5575_f64 == 1.5575_f64)
#assert(-1.5575_f32 == -1.5575_f32)
#assert(-1.5575_f64 == -1.5575_f64)

#assert(1_f32 == 1_f32)
#assert(1_f64 == 1_f64)
#assert(0_f32 == 0_f32)
#assert(0_f64 == 0_f64)
#assert(-1_f32 == -1_f32)
#assert(-1_f64 == -1_f64)

#assert(1 == 1_f32)
#assert(1 == 1_f64)
#assert(1_s8 == 1_f32)
#assert(1_s16 == 1_f64)
#assert(1_s32 == 1_f32)
#assert(1_s64 == 1_f64)
#assert(1_u8 == 1_f32)
#assert(1_u16 == 1_f64)
#assert(1_u32 == 1_f64)
#assert(1_u64 == 1_f64)
#assert(1_f32 == 1_f64)
#assert(-1_s8 == -1_f32)
#assert(-1_s16 == -1_f32)
#assert(-1_s32 == -1_f32)
#assert(-1_s64 == -1_f64)
#assert(-1_s16 == -1_f64)

#assert(1 != 0)
#assert(1_s32 != 0_s8)
#assert(1_s8 != 0_s32)
#assert(1_u32 != 0_u8)
#assert(1_f32 != 0_f32)
#assert(1_f64 != 0_f64)

#assert(1.0 < 2.0)
#assert(2.0 > 1.9)
#assert(2.0 >= 1.9)
#assert(1.0 >= 1.0)
#assert(1.0 <= 1.0)
#assert(1.0 <= 2.0)
#assert(-2.0 < -1.0)
#assert(-1.0 > -2.0)
#assert((1.0 <=> 2.0) == -1)
#assert((2.0 <=> 1.0) == 1)
#assert((1.0 <=> 1.0) == 0)
#assert((1.0_f32 <=> 2.0_f64) == -1)
#assert((2.0_f32 <=> 1.0_f64) == 1)
#assert((1.0_f32 <=> 1.0_f64) == 0)
#assert((1.0_f64 <=> 2.0_f32) == -1)
#assert((2.0_f64 <=> 1.0_f32) == 1)
#assert((1.0_f64 <=> 1.0_f32) == 0)

#assert(1.0 != 1.0 + 1e-10)
#assert(1.0 < 1.0000001)
#assert(1.0 > 0.9999999)
#assert(1.0_f32 != 1.0_f32 + 1e-6)
#assert(1.0_f64 != 1.0_f64 + 1e-12)
#assert(1.0_f32 < 1.0001_f32)
#assert(1.0_f32 > 0.9999_f32)
#assert(1.0_f64 < 1.000000000001_f64)
#assert(1.0_f64 > 0.999999999999_f64)

#assert(1.0_f32 == 1.0_f32)
#assert(1.0_f64 == 1.0_f64)
#assert(0.0_f32 == 0.0_f32)
#assert(0.0_f64 == 0.0_f64)
#assert(-0.0_f32 == 0.0_f32)
#assert(-0.0_f64 == 0.0_f64)
