{
  "name": "swag",
  "displayName": "Swag",
  "description": "Language support for the Swag programming language",
  "version": "0.0.173",
  "publisher": "swag-lang",
  "icon": "images/swag_icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swag-lang/swc"
  },
  "vsce": {
    "baseImagesUrl": "https://github.com/swag-lang/swc/raw/HEAD/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test tests",
    "test:integration": "node --test integration"
  },
  "activationEvents": [
    "onLanguage:swag",
    "onTaskType:swag-build"
  ],
  "contributes": {
    "themes": [
			{
				"label": "Swag Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/swag-dark.json"
			}
		],
    "languages": [
      {
        "id": "swag",
        "aliases": [ "swag" ],
        "extensions": [ ".swg", ".swgs" ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swag",
        "scopeName": "source",
        "path": "./syntaxes/swag.tmLanguage.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "swag-build",
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "enum": ["build", "rebuild", "format"],
            "description": "The compiler task to run"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "swag",
        "source": "swag",
        "owner": "swag",
        "fileLocation": [ "absolute" ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+)(?:-(\\d+))?: (warning|error)(?:\\[[^\\]]+\\])?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "endColumn": 4,
          "severity": 5,
          "message": 6
        }
      },
      {
        "name": "swag-background",
        "source": "swag",
        "owner": "swag",
        "fileLocation": [ "absolute" ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+)(?:-(\\d+))?: (warning|error)(?:\\[[^\\]]+\\])?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "endColumn": 4,
          "severity": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "File change detected",
          "endsPattern": "Watching for file changes"
        }
      }
    ],
    "commands": [
      {
        "command": "swag.restartLanguageServer",
        "title": "Swag: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Swag",
      "properties": {
        "swag.compilerPath": {
          "type": "string",
          "default": "swc",
          "scope": "window",
          "description": "Swag compiler executable with editor snapshot support. Defaults to swc on PATH; set a path only to use a different compiler."
        },
        "swag.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable compiler-backed language features"
        },
        "swag.languageServer.analysisDelay": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Wait this many milliseconds after an edit before analyzing"
        },
        "swag.languageServer.analysisTimeout": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Cancel an analysis after this many milliseconds"
        }
      }
    },
    "configurationDefaults": {
      "[swag]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.11"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Semantic analysis runs compiler and compile-time code only in trusted workspaces."
    },
    "virtualWorkspaces": false
  }
}
