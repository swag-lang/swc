// This Swag script has been done thanks to "The Coding Train" youtube channel.
// https://www.youtube.com/watch?v=4hA7G3gup-4

#import("gui", location: "swag@std")

using Core, Gui, Pixel, Core.Math

var g_Rng:    Random.Generator
var g_Points: Array'C

struct C
{
    pos:    Vector2
    target: Vector2
    speed:  Vector2
    acc:    Vector2
}

impl C
{
    mtd update(wnd: *Wnd)
    {
        let app = wnd.app()

        .speed += .acc
        .pos   += .speed * app.deltaSeconds()
        .acc.setZero()

        var v = .target - .pos
        var d = v.length()
        if d < 100 do
            d = map(d, 0, 100, 0, 120)
        v.setLength(d)
        var steer = v - .speed
        d = min(steer.length(), 80)
        steer.setLengthOrZero(d)
        .acc += steer

        var pm = app.mouseRef().position()
        pm = wnd.screenToSurface(pm)
        pm = wnd.surfaceToLocal(pm)
        v  = .pos - Vector2{pm.x, pm.y}
        d  = v.length()
        if d < 50
        {
            d = 50 - d
            d *= d
            v.setLength(d)
            .acc += v
        }
    }
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case CreateEvent:
        var pl = expect wnd.theme().res.defaultTypeFaceR.buildStringOutline("Swag", 200)

        // The outline arrives in the type's own coordinates, so the word is measured before it is
        // placed. A hand-tuned offset only ever centers it in the one window it was tuned in.
        var minPos = Vector2{Swag.F32.Max, Swag.F32.Max}
        var maxPos = Vector2{Swag.F32.Min, Swag.F32.Min}

        for path in pl.toSlice()
        {
            path.flatten()
            let flattened = path.flattenedPolygon()
            flattened.subdivideEdges(10)
            for &el in flattened.points
            {
                var c: C
                c.pos, c.target = {el.x, el.y}
                g_Points.add(c)

                minPos.x = min(minPos.x, el.x)
                minPos.y = min(minPos.y, el.y)
                maxPos.x = max(maxPos.x, el.x)
                maxPos.y = max(maxPos.y, el.y)
            }
        }

        let rect = wnd.clientRect()
        let dx   = rect.horzCenter() - (minPos.x + maxPos.x) * 0.5
        let dy   = rect.vertCenter() - (minPos.y + maxPos.y) * 0.5

        // Every point starts scattered around the place it is heading for, which is what the
        // opening frames gather up.
        for &c in g_Points
        {
            c.target.x += dx
            c.target.y += dy
            c.pos.x    = c.target.x + g_Rng.nextF32(-100, 100)
            c.pos.y    = c.target.y + g_Rng.nextF32(-100, 100)
        }

    case PaintEvent as paintEvt:
        let painter = paintEvt.paintContext.painter
        let rect    = wnd.clientRect()

        painter.fillRect(rect, Argb.Black)

        for &p in g_Points
        {
            p.update(wnd)
            let v = p.target - p.pos
            let d = map(Math.min(v.length(), 100), 0, 100, 0, 1)
            let c = Color.lerp(Argb.White, Argb.Black, d)
            painter.fillCircle(p.pos.x, p.pos.y, 4, c)
        }

        wnd.invalidate()
    }

    return false
}

#main
{
    Application.runSurface(100, 100, 650, 420, title: "Swag (move mouse on me!)", hook: &onEvent, testFrames: 50)
}
