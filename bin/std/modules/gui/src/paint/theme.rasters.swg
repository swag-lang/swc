#global internal

using Pixel

// Lossless derivatives of the SVG masters, generated by tools/rasterize-theme.swgs.
// Keep this set small: less common sizes retain the exact runtime rasterizer.
func themeIconRaster(cell: s32)->const [..] u8?
{
    switch cell
    {
    case 16: return #include("../theme/icons-16px.png")
    case 20: return #include("../theme/icons-20px.png")
    case 24: return #include("../theme/icons-24px.png")
    case 28: return #include("../theme/icons-28px.png")
    case 32: return #include("../theme/icons-32px.png")
    case 40: return #include("../theme/icons-40px.png")
    case 48: return #include("../theme/icons-48px.png")
    }

    return null
}

func themeWidgetRaster(scale: s32)->const [..] u8?
{
    switch scale
    {
    case 1: return #include("../theme/widgets-1px.png")
    case 2: return #include("../theme/widgets-2px.png")
    }

    return null
}

func decodeThemeRaster(bytes: const [..] u8)->Image
{
    var image = expect Image.decode(".png", bytes)
    image.convertTo(.BGRA8)
    return image
}
