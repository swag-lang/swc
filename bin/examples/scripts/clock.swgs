// https://www.youtube.com/watch?v=ZI1dmHv3MeM&list=PLRqwX-V7Uu6ZiZxtDDRCi6uhfTH4FilpH

#import("gui", location: "swag@std")
#load("surface.swg")

using Core, Gui, Pixel

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case PaintEvent as paintEvt:
        let painter = paintEvt.paintContext.painter

        let bounds = wnd.clientRect()
        let cx     = bounds.horzCenter()
        let cy     = bounds.vertCenter()
        let radius = Math.min(bounds.width, bounds.height) * 0.34
        if radius < 16 do
            return false

        let colors    = wnd.themeColors()
        let now       = Time.DateTime.now()
        let seconds   = now.second + now.millisecond / 1000.0
        let minutes   = now.minute + seconds / 60
        let hours     = (now.hour % 12) + minutes / 60
        let fractions = [hours / 12, minutes / 60, seconds / 60]
        let inks      = [colors.text, colors.softText, colors.arc]

        painter.setParams(.Antialiased)
        painter.clear(colors.ground)
        for fraction, index in fractions
        {
            let ring = radius * (0.68 + cast(f32, index) * 0.16)
            painter.drawCircle(cx, cy, ring, colors.line, 4)
            painter.drawArc(cx, cy, ring, 0, fraction * Math.ConstF32.TwoPi, inks[index], 4)
        }

        let time = Format.toString("%{D02}:%{D02}", now.hour, now.minute)
        painter.drawStringCenter(cx, cy, time, wnd.theme().createDefaultFontFs(28), colors.text)

        wnd.invalidate()
    }

    return false
}

#main
{
    try runExample(466, 481, title: "Clock", hook: &onEvent)
}
