#global namespace Input

// Enumerates gamepad buttons
public enum GamePadButton
{
    A                        // Selects a.
    B                        // Selects b.
    Back                     // Selects back.
    BigButton                // Selects big button.
    DPadDown                 // Selects d pad down.
    DPadLeft                 // Selects d pad left.
    DPadRight                // Selects d pad right.
    DPadUp                   // Selects d pad up.
    LeftShoulder             // Selects left shoulder.
    LeftStick                // Selects left stick.
    LeftThumbstickDown       // Selects left thumbstick down.
    LeftThumbstickLeft       // Selects left thumbstick left.
    LeftThumbstickRight      // Selects left thumbstick right.
    LeftThumbstickUp         // Selects left thumbstick up.
    LeftTrigger              // Selects left trigger.
    RightShoulder            // Selects right shoulder.
    RightStick               // Selects right stick.
    RightThumbstickDown      // Selects right thumbstick down.
    RightThumbstickLeft      // Selects right thumbstick left.
    RightThumbstickRight     // Selects right thumbstick right.
    RightThumbstickUp        // Selects right thumbstick up.
    RightTrigger             // Selects right trigger.
    Start                    // Selects start.
    X                        // Selects x.
    Y                        // Selects y.
}
