// This Swag script has been done thanks to "The Coding Train" youtube channel.
// https://www.youtube.com/watch?v=uWzPe_S-RVE&list=PLRqwX-V7Uu6ZiZxtDDRCi6uhfTH4FilpH

#import("gui", location: "swag@std")

using Core, Gui, Pixel, Core.Math

const SimulationSpeed = 50'f32
const MaxFrameStep    = 1'f32
const FixedStep       = 0.05'f32

// Width the sliders and their edit boxes need. The pendulum hangs from the middle of what is left
// of the window, not from the middle of the window: measured against the whole width it leans
// into the panel as soon as the window is not much wider than the panel is.
const PanelWidth = 360.0

var length1           = 125.0
var length2           = 125.0
var mass1             = 10.0
var mass2             = 10.0
var gravity: f32      = 0.98
var velocityRetention = 1.0

var angle1           = 0.0
var angle2           = 0.0
var angularVelocity1 = 0.0
var angularVelocity2 = 0.0

var originX, originY: f32
var trailPoints:      Array'Vector2

func restartPendulum()
{
    angle1, angle2 = ConstF32.Pi / 2
    angularVelocity1, angularVelocity2 = 0
    trailPoints.clear()
}

func pendulumStateIsFinite()->bool
{
    return Math.isFinite(angle1) and
           Math.isFinite(angle2) and
           Math.isFinite(angularVelocity1) and
           Math.isFinite(angularVelocity2)
}

func stepPendulum(dt: f32)->bool
{
    // Acceleration of the first pendulum from the current angles and velocities.
    var term1 = -gravity * (2 * mass1 + mass2) * sin(angle1)
    var term2 = -mass2 * gravity * sin(angle1 - 2 * angle2)
    var term3 = -2 * sin(angle1 - angle2) * mass2
    var term4 = angularVelocity2 * angularVelocity2 * length2 +
                angularVelocity1 * angularVelocity1 * length1 * cos(angle1 - angle2)
    var denominator   = length1 * (2 * mass1 + mass2 - mass2 * cos(2 * angle1 - 2 * angle2))
    let acceleration1 = (term1 + term2 + term3 * term4) / denominator

    // The second pendulum uses the same state, before either angle advances.
    term1       = 2 * sin(angle1 - angle2)
    term2       = angularVelocity1 * angularVelocity1 * length1 * (mass1 + mass2)
    term3       = gravity * (mass1 + mass2) * cos(angle1)
    term4       = angularVelocity2 * angularVelocity2 * length2 * mass2 * cos(angle1 - angle2)
    denominator = length2 * (2 * mass1 + mass2 - mass2 * cos(2 * angle1 - 2 * angle2))
    let acceleration2 = (term1 * (term2 + term3 + term4)) / denominator

    if not Math.isFinite(acceleration1) or not Math.isFinite(acceleration2) do
        return false

    angularVelocity1 += acceleration1 * dt
    angularVelocity2 += acceleration2 * dt
    angle1           += angularVelocity1 * dt
    angle2           += angularVelocity2 * dt

    angularVelocity1 *= velocityRetention
    angularVelocity2 *= velocityRetention

    return pendulumStateIsFinite()
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case CreateEvent:
        let rect = wnd.clientRect()
        originX = (rect.width - PanelWidth) * 0.5
        originY = 50
        restartPendulum()

        with let panel = StackLayoutCtrl.create(wnd, .Top, {0, 0, PanelWidth})
        {
            .padding   = 10
            .spacing   = 5
            .dockStyle = .Right
        }

        with let length1Slider = SliderCtrl.create(panel, "r1")
        {
            .setUnsignedBounds(50, 200)
            .setValue(length1)
            .slider.sigChanged += func(slider) { length1 = slider.value() }
        }

        with let length2Slider = SliderCtrl.create(panel, "r2")
        {
            .setUnsignedBounds(50, 200)
            .setValue(length2)
            .slider.sigChanged += func(slider) { length2 = slider.value() }
        }

        with let dampingSlider = SliderCtrl.create(panel, "friction")
        {
            .setUnsignedBounds(0, 100)
            .setValue(0)
            .slider.sigChanged += func(slider) { velocityRetention = 1 - (slider.value() * 0.0001) }
        }

        with let button = PushButton.create(panel, "restart")
        {
            .maxSize    = 100
            .sigPressed += func(?) { restartPendulum() }
        }

    case PaintEvent as paintEvt:
        let painter = paintEvt.paintContext.painter

        var remaining = Math.min(wnd.app().deltaSeconds() * SimulationSpeed, MaxFrameStep)
        var valid     = Math.isFinite(remaining)
        while valid and remaining > 0
        {
            let dt = Math.min(remaining, FixedStep)
            if not stepPendulum(dt)
            {
                valid = false
                break
            }

            remaining -= dt
        }

        if not valid do
            restartPendulum()

        let x1 = length1 * sin(angle1)
        let y1 = length1 * cos(angle1)
        let x2 = x1 + length2 * sin(angle2)
        let y2 = y1 + length2 * cos(angle2)

        if not Math.isFinite(x1) or not Math.isFinite(y1) or not Math.isFinite(x2) or not Math.isFinite(y2)
        {
            restartPendulum()
            return false
        }

        painter.setParams(.Antialiased)
        painter.clear(Argb.Black)
        painter.translateTransform(originX, originY)

        // Generate trail
        trailPoints.add({x2, y2})
        if trailPoints.count > 500 do
            trailPoints.removeAtOrdered(0)

        // Draw trail
        if trailPoints.count > 1
        {
            var trail: LinePath
            trail.start(trailPoints[0].x, trailPoints[0].y)
            for point in trailPoints do
                trail.curveTo(point.x, point.y)
            painter.drawPath(&trail, Argb.Red, 2)
        }

        // Pendulum
        painter.drawLine(0, 0, x1, y1, Argb.White, 2)
        painter.fillCircle(x1, y1, mass1, Argb.White)
        painter.drawLine(x1, y1, x2, y2, Argb.White, 2)
        painter.fillCircle(x2, y2, mass2, Argb.White)

        wnd.invalidate()
    }

    return false
}

#main
{
    Application.runSurface(100, 100, 900, 500, title: "Pendulum", borders: false, hook: &onEvent)
}
