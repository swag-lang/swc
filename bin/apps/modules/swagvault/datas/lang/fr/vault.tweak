# The page that creates a vault.
ui_CreateHelp          Choisissez une capacité fixe. Le conteneur complet est randomisé avant d'être prêt.
ui_Location            Emplacement
ui_Capacity            Capacité
ui_UnitMiB             Mio
ui_UnitGiB             Gio
ui_FreeSpace           % libres sur %
ui_Password            Mot de passe
ui_Confirm             Confirmer
ui_OptionalPassword    Facultatif
ui_EnterAgain          Saisissez à nouveau
ui_AddKeyFilesLink     Ajouter des fichiers clés…
ui_Browse              Parcourir
ui_CreateVault         Créer le coffre chiffré

# The page that follows a long operation.
ui_Randomizing         Randomisation du conteneur
ui_Resizing            Redimensionnement du conteneur
ui_Camouflaging        Renouvellement du camouflage
ui_ProgressOf          % sur %
ui_SecondsLeft         encore % s
ui_MinutesLeft         encore % min
ui_RandomizeHelp       Chaque octet est rempli de bruit avant que le coffre soit prêt : de l'extérieur, rien ne distingue les données du vide.

# The privacy and automatic-unmount page.
ui_PrivacyTitle        Vie privée
ui_OptionsHelp         Protégez l'emplacement des coffres et choisissez quand fermer automatiquement les lecteurs protégés.
ui_PrivacyMode         Mode vie privée
ui_PrivacyModeHelp     Ne pas enregistrer les chemins des conteneurs, l'historique de navigation ni les montages au démarrage.
ui_UnmountOnLock       Démonter au verrouillage de Windows
ui_UnmountOnLockHelp   Les lecteurs protégés se ferment dès que la session Windows actuelle est verrouillée.
ui_UnmountOnSuspend    Démonter avant la mise en veille
ui_UnmountOnSuspendHelp Les lecteurs protégés se ferment lorsque Windows met l'ordinateur en veille.
ui_UnmountOnIdle       Démonter après une période d'inactivité
ui_UnmountOnIdleHelp   Les lecteurs protégés se ferment lorsque Windows n'a reçu aucune entrée clavier ou souris pendant %.
ui_Minutes             % minutes

# The boxes that change a vault.
ui_NewCapacity         Nouvelle capacité
ui_NewPassword         Nouveau mot de passe
ui_ConfirmPassword     Confirmer le mot de passe
ui_ContainerPassword   Vide si le coffre n'en a pas
ui_KeyFiles            Fichiers clés
ui_KeyFilesHelp        Chaque fichier listé est requis. Seul son contenu est utilisé : vous pouvez le déplacer sans modifier l'accès.
ui_NoKeyFiles          Aucun fichier clé
ui_AddKeyFiles         Ajouter des fichiers clés existants
ui_GenerateKeyFile     Créer un fichier clé aléatoire
ui_RemoveKeyFile       Retirer le fichier clé sélectionné
ui_RemovePasswordHelp  Laissez vide pour supprimer seulement le mot de passe. Les fichiers clés sélectionnés restent requis.
ui_NewCapacityHelp     Modifier la capacité peut déplacer les blocs utilisés qui ne tiendraient plus.
ui_KeepCapacity        Conserver la capacité actuelle
ui_KeepCapacityHelp    Renouvelle la taille physique aléatoire sans déplacer les données du coffre.
ui_HiddenPassword      Mot de passe du volume caché
ui_HiddenCreateHelp    Utilise un espace libre contigu du coffre. Remplace tout volume caché précédent. Activez la protection à chaque montage du volume contenant pour éviter son écrasement.
ui_HiddenProtectionHelp Saisissez l'accès caché pour protéger son espace. Une écriture conflictuelle bloque les suivantes jusqu'au démontage. Le lecteur caché n'est pas monté.
ui_OuterReserve        Espace à garder pour le volume contenant
ui_OuterReserveHelp    Minimum disponible pour les fichiers ordinaires. Limite seulement la création cachée ; ce choix n'est pas enregistré dans le volume contenant.
ui_Desktop             Bureau
dlg_TitleCreate        Créer un conteneur Swag Vault
dlg_TitleOpen          Ouvrir un conteneur chiffré
dlg_TitlePassword      Changer le mot de passe du coffre
dlg_TitleKeyFiles      Sélectionner des fichiers clés
dlg_TitleAccessKeyFiles Choisir les fichiers clés
dlg_TitleGenerateKey   Créer un fichier clé aléatoire
dlg_TitleChangeKeyFiles Modifier les fichiers clés du coffre
dlg_TitleResize        Modifier la capacité ou le camouflage
dlg_BtnCreate          Créer
dlg_BtnOpen            Ouvrir
dlg_BtnAdd             Ajouter
dlg_BtnApply           Appliquer

# What the line under the title of the list reports, and the boxes a failure opens.
msg_Ready              Prêt — créez un coffre ou choisissez-en un à ouvrir.
msg_OperationStopped   L'opération s'est arrêtée.
msg_SystemError        Erreur système.
msg_SizeInvalid        La taille du conteneur n'est pas valide.
msg_SizeTooLarge       La taille du conteneur est trop grande.
msg_SizeMinimum        La taille minimale du conteneur est de % Mio.
msg_ChooseCreateFile   Choisissez le fichier conteneur à créer.
msg_FileExists         Ce fichier existe déjà. Choisissez un autre nom pour éviter toute perte de données.
msg_PasswordRequired   Un mot de passe est requis.
msg_PasswordMismatch   Les mots de passe ne correspondent pas.
msg_KeyFileCreateFailed Impossible de créer le fichier clé aléatoire.
msg_CreateFailed       Impossible de créer le conteneur.
msg_Randomizing        Création et randomisation du conteneur... %{#0} %%
msg_StopRequested      Arrêt en cours...
msg_CreateCanceled     Création du conteneur annulée. Rien n'a été laissé sur le disque.
msg_HiddenCreateCanceled Création cachée annulée ; un ancien volume caché peut être endommagé.
msg_ChooseExisting     Choisissez un conteneur existant.
msg_AlreadyMounted     Un lecteur expose déjà ce conteneur.
msg_UnmountFirst       Ce coffre est monté. Démontez-le avant de le modifier.
msg_NoDriveLetter      Aucune lettre de lecteur n'est disponible.
msg_StartingDriver     Démarrage du pilote de système de fichiers portable...
msg_Unmounting         Synchronisation et démontage du lecteur chiffré...
msg_CreateStopped      La création du conteneur s'est arrêtée.
msg_Created            Conteneur créé. Il est prêt à être ouvert.
msg_MountFailed        Impossible de monter le disque virtuel.
msg_MountStopped       Le montage s'est arrêté.
msg_Mounted            Lecteur chiffré monté sur %.
msg_MountedReadOnly    Lecteur chiffré monté en lecture seule sur %.
msg_MountedProtected   Le lecteur % est monté avec protection du volume caché.
msg_UnmountSyncStopped Le lecteur a été démonté, mais la synchronisation finale s'est arrêtée.
msg_Unmounted          Lecteur démonté en toute sécurité.
msg_Resizing           Redimensionnement du conteneur... %{#0} %%
msg_Camouflaging       Renouvellement du camouflage physique... %{#0} %%
msg_ResizeCanceled     Redimensionnement arrêté. Le coffre a conservé sa taille précédente.
msg_ResizeStopped      Le redimensionnement s'est arrêté.
msg_ResizeFailed       Impossible de redimensionner le conteneur.
msg_Resized            Le coffre contient désormais %.
msg_Camouflaged        Le coffre a conservé sa capacité et reçu une nouvelle taille physique.
msg_AutoUnmounted      Les lecteurs protégés ont été démontés automatiquement.
msg_AutoUnmountStopped Les lecteurs protégés ont été démontés, mais la synchronisation finale s'est arrêtée.
msg_ChangingPassword   Réécriture de l'emplacement de clé...
msg_PasswordChanged    Le coffre s'ouvre désormais avec le nouveau mot de passe.
msg_PasswordRemoved    Le mot de passe a été supprimé. Les fichiers clés sélectionnés restent requis.
msg_PasswordFailed     Impossible de changer le mot de passe.
msg_PasswordStopped    Le changement de mot de passe s'est arrêté.
msg_KeyFilesChanged    Le coffre s'ouvre désormais avec les fichiers clés sélectionnés.
msg_KeyFilesStopped    La modification des fichiers clés s'est arrêtée.
msg_KeyFilesFailed     Impossible de modifier les fichiers clés.
msg_HiddenProtected    La protection du volume caché empêche cette modification. Démontez le volume avant de continuer.

# Sentences a failure shows, one per ErrorKind.
msg_ErrPasswordOrDamaged Le mot de passe ou les fichiers clés sont incorrects, ou le conteneur est endommagé.
msg_ErrDamaged           Le conteneur est endommagé.
msg_ErrNotFound          Le conteneur est introuvable.
msg_ErrAlreadyExists     Un fichier portant ce nom existe déjà.
msg_ErrAccessDenied      L'accès au conteneur a été refusé.
msg_ErrReadOnly          Le coffre est monté en lecture seule.
msg_ErrSparse            Le conteneur est sparse. Convertissez-le en fichier entièrement alloué avant de l'ouvrir.
msg_ErrDiskFull          Il n'y a plus de place dans le conteneur.
msg_ErrIo                Le conteneur n'a pas pu être lu ou écrit.
msg_ErrInvalidRequest    Le conteneur ne peut pas répondre à cette demande.
msg_ErrElevated          Swag Vault a été lancé en tant qu'administrateur : l'Explorateur Windows ne peut pas afficher son lecteur. Fermez-le et relancez-le normalement.
msg_ErrDriverUnavailable Le lecteur virtuel n'a pas pu démarrer.
msg_ErrorCode            Code d'erreur : 0x%{X}
