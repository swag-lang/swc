#import("gui", location: "swag@std")

using Gui, Core, Pixel

const CellCount = 4

// The board was drawn at this cell size, and every other measurement of the game is a ratio of
// it: the gap a cell keeps inside itself, the corner it is cut with, the pop a new tile arrives
// with, and the size of the digits on it. Held as ratios they follow the window; held as pixels
// they only ever fit the one window they were tuned in.
const CellRef     = 128.0
const MarginRatio = 8.0 / CellRef
const CornerRatio = 8.0 / CellRef
const PopRatio    = 40.0 / CellRef
const BandRatio   = 120.0 / CellRef     // Room the score keeps above the board, air included.
const OuterRatio  = 16.0 / CellRef      // Air between the window edge and the board, on all four sides.
const LabelRatio  = 20.0 / CellRef      // Center of the caption inside the band.
const ScoreRatio  = 60.0 / CellRef      // Center of the score inside the band.

// Where the board sits in the window, and at what size.
struct BoardLayout
{
    grid:   Math.Rectangle     // Square the cells are laid out in.
    cell:   f32                // Side of one cell, its gap included.
    margin: f32                // Gap kept inside a cell, and around the board.
    corner: f32                // Corner radius of the board and of every tile.
    zoom:   f32                // Scale the authored type and the pop animation are drawn at.
    labelY: f32                // Center of the "score" caption.
    scoreY: f32                // Center of the score itself.
}

// Measures the board for `rect`.
//
// One unknown decides the whole frame: the cell. Everything else — the gap, the corner, the band
// the score is written in, the digits — is a ratio of it, so the score cannot be sized against
// the window while the type that fills it is sized against the cell. Solving for the cell once,
// against both the width and the height, is what keeps the score off the board at any shape.
func boardLayout(rect: Math.Rectangle)->BoardLayout
{
    var result: retval

    // Across: the outer air, the gap the board keeps around its cells, and the four cells.
    // Down: the same, with the score's band added above the board.
    const AcrossRatio = CellCount + 2 * MarginRatio + 2 * OuterRatio
    const DownRatio   = CellCount + 2 * MarginRatio + 2 * OuterRatio + BandRatio

    result.cell   = Math.min(rect.width / AcrossRatio, rect.height / DownRatio)
    result.margin = result.cell * MarginRatio
    result.corner = result.cell * CornerRatio
    result.zoom   = result.cell / CellRef

    // What is left over once the frame is measured goes above and below it in equal parts, so a
    // window that is not the board's shape holds it in the middle instead of against an edge.
    let outer = result.cell * OuterRatio
    let band  = result.cell * BandRatio
    let size  = result.cell * CellCount
    let top   = outer + Math.max((rect.height - result.cell * DownRatio) * 0.5, 0)

    result.grid.x = rect.horzCenter() - size * 0.5
    result.grid.y = top + band + result.margin
    result.grid.width, result.grid.height = size

    result.labelY = top + result.cell * LabelRatio
    result.scoreY = top + result.cell * ScoreRatio
    return result
}

struct Cell
{
    z:        f32 = 0.1
    zd:       f32 = 1.0
    x, y:     f32
    xd, yd:   f32
    nxd, nyd: f32
    val:      s32
    moving:   bool
    remove:   bool
}

var g_Cells:     Array'Cell
var g_Font:      #null *Font
var g_LabelFont: #null *Font
var g_MoveDirX:  s32
var g_MoveDirY:  s32
var g_IsMoving:  bool
var g_GameOver:  bool
var g_Score:     s32

func paintGrid(wnd: *Wnd, painter: *Painter)
{
    let layout = boardLayout(wnd.clientRect())
    let cellW  = layout.cell - (2 * layout.margin)

    painter.setAntialiased(true)
    var rectBack = layout.grid
    rectBack.inflate(layout.margin)
    painter.fillRoundRect(rectBack, layout.corner, layout.corner, Color.fromRgb(187, 173, 160))

    for [x] in CellCount
    {
        for [y] in CellCount
        {
            let xi = layout.grid.x + (x * layout.cell) + layout.margin
            let yi = layout.grid.y + (y * layout.cell) + layout.margin
            painter.fillRoundRect(xi, yi, cellW, cellW, layout.corner, layout.corner, Color.fromRgb(204, 192, 178))
        }
    }

    for &c in g_Cells
    {
        var color: Color

        let xi = layout.grid.x + (c.x * layout.cell) + layout.margin
        let yi = layout.grid.y + (c.y * layout.cell) + layout.margin

        switch c.val
        {
        case 0:   color = Color.fromRgb(204, 192, 178)
        case 2:   color = Color.fromRgb(238, 238, 218)
        case 4:   color = Color.fromRgb(236, 224, 201)
        case 8:   color = Color.fromRgb(242, 177, 122)
        case 16:  color = Color.fromRgb(246, 149, 100)
        case 32:  color = Color.fromRgb(248, 124, 96)
        case 64:  color = Color.fromRgb(245, 94, 57)
        case 128: color = Color.fromRgb(237, 208, 115)
        default:  color = Color.fromRgb(238, 194, 46)
        }

        let off = (1 - c.z) * layout.cell * PopRatio
        painter.fillRoundRect(xi + off, yi + off, cellW - 2 * off, cellW - 2 * off, layout.corner, layout.corner, color)
        if !c.val do
            continue

        // Paint cell value
        let str  = Format.toString("%", c.val)
        var zoom = c.z
        zoom -= (cast(f32) str.length * 0.08)
        painter.drawStringCenter(xi + (cellW * 0.5), yi + (cellW * 0.5), str, g_Font!, Argb.Black, zoom: zoom * layout.zoom)
    }
}

func randValue()
{
    for
    {
        let x = Random.shared().nextS32(0, CellCount)
        let y = Random.shared().nextS32(0, CellCount)
        if cellAt(x, y) do
            continue

        var cell: Cell
        cell.x, cell.xd, cell.nxd = x
        cell.y, cell.yd, cell.nyd = y
        cell.val = Random.shared().nextBool() ? 2 : 4
        g_Cells.add(cell)
        break
    }
}

func animate(wnd: *Wnd)
{
    let dt = wnd.app().deltaSeconds()

    let wasMoving = g_IsMoving
    g_IsMoving = false
    for &c in g_Cells
    {
        // End of scale
        if Math.isEqualEpsilon(c.z, c.zd, 0.01) do
            c.zd = 1
        c.z = Math.lerp(c.z, c.zd, 20 * dt)
        if Math.isEqualEpsilon(c.z, 1, 0.01) do
            c.z = 1

        // End of move
        if c.moving
        {
            c.x = Math.lerp(c.x, c.xd, 20 * dt)
            c.y = Math.lerp(c.y, c.yd, 20 * dt)
            if Math.isEqualEpsilon(c.x, c.xd, 0.1) and Math.isEqualEpsilon(c.y, c.yd, 0.1)
            {
                c.moving = false
                let dest = cellAt(cast(s32) c.xd, cast(s32) c.yd, c)
                if dest and dest.val
                {
                    c.moving    = true
                    dest.remove = true
                    c.val       *= 2
                    c.zd        = 1.2
                    g_Score     += c.val
                }

                c.x = c.xd
                c.y = c.yd
            }
            else
            {
                g_IsMoving = true
            }
        }
    }

    if wasMoving and !g_IsMoving do
        randValue()

    for #reverse [i] in g_Cells.count where g_Cells[i].remove do
        g_Cells.removeAt(i)
}

func cellAt(x, y: s32, self: #null *Cell = null)->#null *Cell
{
    for &c in g_Cells
    {
        if c == self do
            continue
        if c.x == x and c.y == y do
            return c
    }

    return null
}

func canMoveTo(val, x, y: s32)->bool
{
    var cpt = 0
    for c in g_Cells
    {
        if (c.val and c.moving and c.xd == x and c.yd == y) or
           (c.val and !c.moving and c.x == x and c.y == y)
        {
            if c.val != val do
                return false
            cpt += 1
            if cpt > 1 do
                return false
        }
    }

    return true
}

func keyboard(wnd: *Wnd)
{
    if g_IsMoving or g_GameOver do
        return

    let kb = wnd.app().keyboardRef()

    switch
    {
    case kb.isKeyJustPressed(.Left):  g_MoveDirX = -1
    case kb.isKeyJustPressed(.Right): g_MoveDirX = 1
    case kb.isKeyJustPressed(.Up):    g_MoveDirY = -1
    case kb.isKeyJustPressed(.Down):  g_MoveDirY = 1
    default: g_MoveDirX, g_MoveDirY = 0
    }

    var recom = true
    while recom
    {
        recom = false
        for &c in g_Cells
        {
            if c.val == 0 do
                continue

            for [i] in 1 to CellCount
            {
                if g_MoveDirX != 0
                {
                    let nx = cast(s32) (c.xd + i * g_MoveDirX)
                    if nx < 0 or nx >= CellCount do
                        break
                    if c.xd == nx or canMoveTo(c.val, nx, cast(s32) c.y)
                    {
                        c.moving = true
                        c.nxd    = nx
                    }

                    break
                }
                elif g_MoveDirY != 0
                {
                    let ny = cast(s32) (c.yd + i * g_MoveDirY)
                    if ny < 0 or ny >= CellCount do
                        break
                    if c.yd == ny or canMoveTo(c.val, cast(s32) c.x, ny)
                    {
                        c.moving = true
                        c.nyd    = ny
                    }

                    break
                }
            }
        }

        for &c in g_Cells
        {
            if !c.val do
                continue
            if Math.isEqualEpsilon(c.xd, c.nxd) and Math.isEqualEpsilon(c.yd, c.nyd) do
                continue
            recom = true
            c.xd  = c.nxd
            c.yd  = c.nyd
        }
    }
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case CreateEvent:
        g_Font      = wnd.theme().createDefaultFont(50)
        g_LabelFont = wnd.theme().createDefaultFont(25)
        randValue()
        randValue()

    case PaintEvent as paintEvt:
        let painter = paintEvt.paintContext.painter
        let rect    = wnd.clientRect()

        painter.fillRect(rect, Color.fromRgb(43, 43, 43))

        let layout = boardLayout(rect)
        painter.drawStringCenter(rect.horzCenter(), layout.labelY, "score", g_LabelFont!, Argb.White, zoom: layout.zoom)
        let str = Format.toString("%", g_Score)
        painter.drawStringCenter(rect.horzCenter(), layout.scoreY, str, g_Font!, Argb.White, zoom: layout.zoom)

        keyboard(wnd)
        paintGrid(wnd, painter)
        animate(wnd)

        wnd.invalidate()
    }

    return false
}

#main
{
    Application.runSurface(100, 100, 480, 620, title: "2048", hook: &onEvent)
}
