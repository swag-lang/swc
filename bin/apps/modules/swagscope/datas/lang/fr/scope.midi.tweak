# French strings of the Swag Scope MIDI viewer. A key omitted here keeps its English value.

ui_Track         Piste
ui_AllTracks     Toutes les pistes
ui_TrackName     Piste %
ui_TrackChoice   % — %
ui_ZoomOut       Réduire le zoom
ui_ZoomIn        Agrandir le zoom
ui_Fit           Ajuster la partition complète
ui_ZoomMenu      Zoom horizontal · Ctrl+molette : zoom vertical · Page précédente/suivante : défilement
ui_PitchLabels   Noms des notes (C4 = MIDI 60)
ui_KeyboardWidth Largeur du clavier de piano
ui_KeyboardCompact Compacte
ui_KeyboardStandard Standard
ui_KeyboardWide Large
ui_PitchScientific Noms C4
ui_PitchMidiNumber Nombres MIDI
ui_PianoRoll     PIANO-ROLL
ui_NoNotes       Aucun événement de note
ui_OneTrack      1 piste
ui_Tracks        % pistes
ui_OneNote       1 note
ui_Notes         % notes
ui_Summary       % · % · % · % BPM · % · %
ui_Details       % · % · % · %
ui_Channel       canal %
ui_Presentation  Présentation
ui_ByTrack       Pistes
ui_ByPitch       Piano-roll
ui_Major         majeur
ui_Minor         mineur
err_TooLarge     le viewer MIDI accepte les fichiers de 32 Mio au maximum
err_TooManyNotes le fichier MIDI contient trop de notes pour être affiché sans risque
err_Header       le fichier ne contient pas d'en-tête Standard MIDI valide
err_Track        la chaîne des pistes MIDI se termine avant le nombre déclaré
err_Event        un événement MIDI se termine hors de sa piste
