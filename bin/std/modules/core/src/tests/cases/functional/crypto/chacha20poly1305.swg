#global if #command == Swag.CompilerCommand.Test
#global private

func rangeBytes(count: u64, first: u8)->Array!{u8}
{
    var result: #returntype
    result.resize(count)
    for i in count
    {
        result[i] = cast(u8, ((first + i) & 0xFF))
    }

    return result
}

// OpenSSL ciphertext and tags for the short-message path and its first fallback.
#test
{
    let key = rangeBytes(32, 0x53)
    let nonce = rangeBytes(12, 0xA1)
    let plaintext = rangeBytes(65, 0x31)
    const Associated = "short record"
    const Lengths: [10] u64 = [1, 15, 16, 31, 32, 47, 48, 63, 64, 65]
    const Ciphertext: [65] u8 = [
        0x90, 0xDB, 0xD7, 0xB5, 0xB9, 0x71, 0x02, 0xBB, 0xCD, 0xC0, 0x42, 0x95,
        0xB9, 0x34, 0x13, 0xE0, 0xD9, 0xBD, 0x35, 0x03, 0x6A, 0x70, 0xE2, 0xF4,
        0x1B, 0x17, 0x8D, 0x31, 0x4A, 0x0E, 0x5B, 0xEF, 0xD8, 0xA2, 0x91, 0x9C,
        0x2A, 0xB8, 0x37, 0x8F, 0x38, 0x35, 0x90, 0x3A, 0x2A, 0xB8, 0xFE, 0xF5,
        0x1D, 0x3D, 0xDD, 0x59, 0x8A, 0xB8, 0x68, 0x33, 0x03, 0xC2, 0x2B, 0xC4,
        0x58, 0x1B, 0x5F, 0xA6, 0x36]
    const Tags: [10] Crypto.Poly1305Tag = [
        [0x60, 0xEA, 0x70, 0x33, 0x28, 0x92, 0xB0, 0xB9, 0x89, 0xBA, 0x78, 0xA6, 0x34, 0x52, 0x73, 0x1F],
        [0xC1, 0xDC, 0xB6, 0x78, 0xB6, 0x30, 0x7B, 0x28, 0xE4, 0x18, 0x63, 0x46, 0x8C, 0x22, 0x8A, 0xE5],
        [0x7E, 0x24, 0xEE, 0xF5, 0x39, 0x6D, 0xF2, 0x2A, 0xE5, 0xE3, 0x73, 0x2C, 0x90, 0xAB, 0x3D, 0x70],
        [0xEB, 0xCB, 0x5E, 0x90, 0xDC, 0xDE, 0xB2, 0x54, 0xD2, 0xE2, 0x24, 0x4C, 0xC8, 0x0A, 0xDF, 0x40],
        [0x29, 0x24, 0xDA, 0x9C, 0xE2, 0x1F, 0x29, 0x5F, 0xE9, 0xFD, 0x94, 0x34, 0x0E, 0x98, 0x87, 0xCA],
        [0x6A, 0xAB, 0xA3, 0x6E, 0x03, 0x68, 0x89, 0x49, 0x2F, 0x87, 0x22, 0xE9, 0xA1, 0x23, 0x1B, 0x29],
        [0x3E, 0x0A, 0x07, 0x4E, 0xD7, 0xAA, 0x65, 0x8A, 0xB5, 0x28, 0x1F, 0x6C, 0x35, 0x4C, 0xBF, 0x18],
        [0x29, 0x4A, 0x09, 0x7D, 0xAE, 0xBD, 0x86, 0x05, 0xF6, 0x36, 0x2C, 0x52, 0x41, 0xEE, 0x7C, 0x52],
        [0x23, 0x52, 0x28, 0xAE, 0xC1, 0xE8, 0x23, 0xFA, 0xC3, 0x43, 0x99, 0xB7, 0x01, 0x9A, 0x05, 0xAE],
        [0x1A, 0xEA, 0xDE, 0x6F, 0x07, 0xFF, 0x29, 0xB7, 0x8C, 0xD0, 0x60, 0xB0, 0xB4, 0x0B, 0x25, 0x5F]]

    for length, index in Lengths
    {
        var actual: [65] u8
        Memory.copy(actual.buffer, plaintext.toSlice().buffer, actual.count)
        let record = actual[until length]
        var tag: Crypto.Poly1305Tag
        expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce.toSlice(), record, Associated, record, tag)
        Swag.require(Crypto.constantTimeEqual(record, Ciphertext[until length]))
        Swag.require(Crypto.constantTimeEqual(tag, Tags[index]))
        Swag.require(Slice.equals(actual[length until actual.count], plaintext.toSlice()[length until actual.count]))

        let opened = expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), record, tag, Associated, record)
        Swag.require(opened)
        Swag.require(Slice.equals(actual, plaintext.toSlice()))
    }
}

// OpenSSL records on both sides of the short authentication frame limits.
#test
{
    let key            = rangeBytes(32, 0x22)
    let nonce          = rangeBytes(12, 0x52)
    let associatedData = rangeBytes(65, 0x71)
    let message        = rangeBytes(129, 0x31)
    const Layouts: [6][2] u64 = [[0, 0], [63, 127], [64, 128], [65, 128], [64, 129], [65, 129]]
    const ExpectedCiphertext: [129] u8 = [
        0x87, 0xD4, 0xEC, 0xD1, 0xD9, 0x30, 0x72, 0x8D, 0xBE, 0x79, 0xB3, 0x5F,
        0xF1, 0x7A, 0xF9, 0xB7, 0xEB, 0x3B, 0xF1, 0x6B, 0x17, 0x9D, 0x74, 0x13,
        0x94, 0x75, 0xE9, 0xDE, 0x0D, 0xCE, 0x71, 0x65, 0x0A, 0xAB, 0x7F, 0x26,
        0x3C, 0xFB, 0x8E, 0x23, 0x6F, 0xA3, 0x19, 0x45, 0x17, 0x57, 0xEA, 0xC3,
        0x3C, 0xB2, 0xB9, 0xDB, 0x82, 0xBE, 0xA5, 0x27, 0xF6, 0xFA, 0x9F, 0x96,
        0xEC, 0xE5, 0x39, 0x5A, 0x28, 0xE4, 0x78, 0x86, 0x1E, 0xD4, 0x1A, 0x04,
        0xB7, 0x01, 0x09, 0x19, 0xE1, 0x24, 0xD3, 0x3F, 0x77, 0x0D, 0xEA, 0xC9,
        0x06, 0xD7, 0xC2, 0xFC, 0xF6, 0xD0, 0x00, 0x7E, 0xFA, 0xD7, 0xA0, 0xD5,
        0xDF, 0x53, 0x60, 0xBB, 0xE9, 0x23, 0xA1, 0x4D, 0x9A, 0x62, 0x74, 0x4F,
        0xF2, 0xD8, 0xD8, 0x75, 0xCA, 0x5B, 0xA5, 0xD3, 0x96, 0xB9, 0xF9, 0x41,
        0x39, 0x1E, 0x26, 0x16, 0x7F, 0xE9, 0x68, 0xA5, 0x57]
    const ExpectedTags: [6] Crypto.Poly1305Tag = [
        [0x93, 0x66, 0xE1, 0x76, 0x8D, 0xF4, 0x1A, 0x76, 0xC3, 0x69, 0x34, 0x2B, 0xBF, 0x2E, 0xCF, 0x5E],
        [0xF3, 0xD2, 0x98, 0x1D, 0x60, 0xD0, 0xF4, 0x8E, 0x64, 0x63, 0x73, 0x82, 0x4E, 0x7F, 0xC8, 0x3F],
        [0x0F, 0x8B, 0x86, 0x27, 0xFB, 0xB7, 0x2B, 0x76, 0xDD, 0x7A, 0x14, 0xED, 0x66, 0xFB, 0x95, 0x81],
        [0xFF, 0x0D, 0x85, 0x89, 0x1D, 0xEE, 0xC2, 0x3D, 0x81, 0x2E, 0x9E, 0x73, 0xAB, 0xD8, 0x0C, 0xEC],
        [0x36, 0xA8, 0x27, 0xC4, 0xA1, 0x66, 0xF0, 0x92, 0x36, 0x5E, 0x9B, 0x1D, 0x06, 0xC1, 0x86, 0x52],
        [0x87, 0xCB, 0x6F, 0x92, 0x1E, 0xC6, 0x84, 0xEA, 0xCA, 0xBF, 0xB8, 0x03, 0x94, 0xDB, 0x85, 0x33]]

    for layout, index in Layouts
    {
        let aad        = associatedData.toSlice()[until layout[0]]
        let input      = message.toSlice()[until layout[1]]
        var output: [129] u8
        var ciphertext = output[until layout[1]]
        var tag:    Crypto.Poly1305Tag
        expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce.toSlice(), input, aad, ciphertext, tag)
        Swag.require(Slice.equals(ciphertext, ExpectedCiphertext[until layout[1]]))
        Swag.require(Crypto.constantTimeEqual(tag, ExpectedTags[index]))
        Swag.require(expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext, tag, aad, ciphertext))
        Swag.require(Slice.equals(ciphertext, input))
    }
}

// With r = 1, the sum of these two blocks straddles 2^130 - 5.
#test
{
    var key:  [Crypto.Poly1305KeySize] u8
    var data: [2 * Crypto.Poly1305BlockSize] u8
    key[0] = 1
    Swag.memset(data.buffer, 0xFF, data.count)
    const LowBytes: [7] u8 = [0xF8, 0xF9, 0xFA, 0, 1, 2, 3]
    for lowByte, index in LowBytes
    {
        data[Crypto.Poly1305BlockSize] = cast(u8, 0xF9 + index)
        var tag: Crypto.Poly1305Tag
        if index < 3
        {
            Swag.memset(tag.buffer, 0xFF, tag.count)
        }

        tag[0] = lowByte
        Swag.require(Crypto.constantTimeEqual(expect Crypto.Poly1305.compute(key, data), tag))
        var mac = expect Crypto.Poly1305.create(key)
        mac.update(data[until 15])
        mac.update(data[15 until data.count])
        Swag.require(Crypto.constantTimeEqual(mac.finalize(), tag))
    }
}

// Authentication sees every completed parallel write; a rejected in-place open changes nothing.
#test
{
    Swag.setWorkerCount(4)
    let key       = rangeBytes(32, 0x11)
    let nonce     = rangeBytes(12, 0x22)
    let plaintext = rangeBytes(2 * 65536 + 193, 0x44)
    var ciphertext: Array!{u8}
    ciphertext.resize(plaintext.count)
    var tag: Crypto.Poly1305Tag
    expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce.toSlice(), plaintext.toSlice(), "parallel record", ciphertext.toSlice(), tag)

    var sealed: Array!{u8}
    sealed.add(ciphertext.toSlice())
    tag[0] ^= 1
    let rejected = expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, "parallel record", ciphertext.toSlice())
    Swag.require(not rejected)
    Swag.require(Crypto.constantTimeEqual(ciphertext.toSlice(), sealed.toSlice()))

    tag[0] ^= 1
    let opened = expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, "parallel record", ciphertext.toSlice())
    Swag.require(opened)
    Swag.require(Crypto.constantTimeEqual(ciphertext.toSlice(), plaintext.toSlice()))

    var inPlaceTag: Crypto.Poly1305Tag
    expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), "parallel record", ciphertext.toSlice(), inPlaceTag)
    Swag.require(Crypto.constantTimeEqual(ciphertext.toSlice(), sealed.toSlice()))
    Swag.require(Crypto.constantTimeEqual(tag, inPlaceTag))
}

#test
{
    // RFC 8439 section 2.5.2.
    let key: [32] u8 = [
        0x85, 0xD6, 0xBE, 0x78, 0x57, 0x55, 0x6D, 0x33,
        0x7F, 0x44, 0x52, 0xFE, 0x42, 0xD5, 0x06, 0xA8,
        0x01, 0x03, 0x80, 0x8A, 0xFB, 0x0D, 0xB2, 0xFD,
        0x4A, 0xBF, 0xF6, 0xAF, 0x41, 0x49, 0xF5, 0x1B]

    let tag = expect Crypto.Poly1305.compute(key, "Cryptographic Forum Research Group")
    let expected: [16] u8 = [
        0xA8, 0x06, 0x1D, 0xC1, 0x30, 0x51, 0x36, 0xC6,
        0xC2, 0x2B, 0x8B, 0xAF, 0x0C, 0x01, 0x27, 0xA9]
    Swag.require(Crypto.constantTimeEqual(tag, expected))
}

#test
{
    // The incremental path must agree with the one-shot path across block
    // boundaries, and an empty message is a valid message.
    let key = rangeBytes(32, 0x40)

    let empty    = expect Crypto.Poly1305.compute(key.toSlice(), "")
    var emptyMac = expect Crypto.Poly1305.create(key.toSlice())
    Swag.require(Crypto.constantTimeEqual(empty, emptyMac.finalize()))

    let message = rangeBytes(97, 1)
    let oneShot = expect Crypto.Poly1305.compute(key.toSlice(), message.toSlice())

    var streamed = expect Crypto.Poly1305.create(key.toSlice())
    var offset   = 0_u64
    while offset < message.count
    {
        let chunk = Math.min(message.count - offset, 5_u64)
        streamed.update(message.toSlice()[offset until offset + chunk])
        offset += chunk
    }

    Swag.require(Crypto.constantTimeEqual(oneShot, streamed.finalize()))
    Swag.require(not Crypto.constantTimeEqual(oneShot, empty))
}

// Covers every tail length after a run of complete blocks, using tags generated by OpenSSL.
// All-one bytes stress carry propagation and the clamped multiplier.
#test
{
    var key:  [Crypto.Poly1305KeySize] u8
    var data: [80] u8
    Swag.memset(key.buffer, 0xFF, key.count)
    Swag.memset(data.buffer, 0xFF, data.count)

    let expected: [16] Crypto.Poly1305Tag = [
        [0x90, 0x0F, 0xE3, 0x2B, 0xC1, 0x5F, 0xA8, 0xD7, 0xBC, 0xA8, 0xEF, 0xE4, 0xC7, 0xE3, 0x7E, 0xB1],
        [0xE4, 0xD8, 0xB1, 0x31, 0xF2, 0x96, 0xFA, 0x07, 0x23, 0x79, 0x61, 0x21, 0x69, 0x4F, 0xFA, 0x18],
        [0xBC, 0x02, 0xB0, 0x31, 0xD2, 0xBE, 0xF2, 0x07, 0x03, 0xA1, 0x59, 0x21, 0x49, 0x77, 0xF2, 0x18],
        [0xBC, 0xDA, 0xD9, 0x2F, 0xD2, 0x9E, 0x1A, 0x00, 0x03, 0x81, 0x81, 0x19, 0x49, 0x57, 0x1A, 0x11],
        [0xB2, 0xDA, 0xB1, 0x59, 0xD0, 0x9E, 0xFA, 0x27, 0xFB, 0x80, 0x61, 0x41, 0x41, 0x57, 0xFA, 0x38],
        [0xE4, 0xD0, 0xB1, 0x31, 0xFA, 0x9C, 0xFA, 0x07, 0x23, 0x79, 0x61, 0x21, 0x69, 0x4F, 0xFA, 0x18],
        [0xBC, 0x02, 0xA8, 0x31, 0xD2, 0xC6, 0xF8, 0x07, 0x03, 0xA1, 0x59, 0x21, 0x49, 0x77, 0xF2, 0x18],
        [0xBC, 0xDA, 0xD9, 0x27, 0xD2, 0x9E, 0x22, 0x06, 0x03, 0x81, 0x81, 0x19, 0x49, 0x57, 0x1A, 0x11],
        [0xB2, 0xDA, 0xB1, 0x59, 0xC8, 0x9E, 0xFA, 0x2F, 0x01, 0x81, 0x61, 0x41, 0x41, 0x57, 0xFA, 0x38],
        [0xE4, 0xD0, 0xB1, 0x31, 0xFA, 0x94, 0xFA, 0x07, 0x2B, 0x7F, 0x61, 0x21, 0x69, 0x4F, 0xFA, 0x18],
        [0xBC, 0x02, 0xA8, 0x31, 0xD2, 0xC6, 0xF0, 0x07, 0x03, 0xA9, 0x5F, 0x21, 0x49, 0x77, 0xF2, 0x18],
        [0xBC, 0xDA, 0xD9, 0x27, 0xD2, 0x9E, 0x22, 0xFE, 0x02, 0x81, 0x89, 0x1F, 0x49, 0x57, 0x1A, 0x11],
        [0xB2, 0xDA, 0xB1, 0x59, 0xC8, 0x9E, 0xFA, 0x2F, 0xF9, 0x80, 0x61, 0x49, 0x47, 0x57, 0xFA, 0x38],
        [0xE4, 0xD0, 0xB1, 0x31, 0xFA, 0x94, 0xFA, 0x07, 0x2B, 0x77, 0x61, 0x21, 0x71, 0x55, 0xFA, 0x18],
        [0xBC, 0x02, 0xA8, 0x31, 0xD2, 0xC6, 0xF0, 0x07, 0x03, 0xA9, 0x57, 0x21, 0x49, 0x7F, 0xF8, 0x18],
        [0xBC, 0xDA, 0xD9, 0x27, 0xD2, 0x9E, 0x22, 0xFE, 0x02, 0x81, 0x89, 0x17, 0x49, 0x57, 0x22, 0x17]]

    for tail in expected.count
    {
        let message = data[1 until 65 + tail]
        let tag     = expect Crypto.Poly1305.compute(key, message)
        Swag.require(Crypto.constantTimeEqual(tag, expected[tail]))

        // Feed a partial block before a call that spans several blocks and another tail.
        for split in 0 to Crypto.Poly1305BlockSize
        {
            var mac = expect Crypto.Poly1305.create(key)
            mac.update(message[until split])
            mac.update(message[split until message.count])
            let streamed = mac.finalize()
            Swag.require(Crypto.constantTimeEqual(streamed, expected[tail]))
        }
    }
}

// OpenSSL tags straddle the four-block folding threshold, odd blocks and unaligned buffered input.
#test
{
    var key: [Crypto.Poly1305KeySize] u8
    for index in key.count
    {
        key[index] = cast(u8, (index * 53 + 17) & 255)
    }

    var data: [8194] u8
    for index in data.count
    {
        data[index] = cast(u8, (index * 97 + (index >> 3) * 11 + 243) & 255)
    }

    let lengths:  [17] u64 = [1023, 1024, 1025, 1040, 1056, 1072, 1087, 1088, 2047, 2048, 2049, 2063, 2064, 2065, 4096, 4097, 8193]
    let expected: [17] Crypto.Poly1305Tag = [
        [0xB3, 0x3D, 0x91, 0x95, 0x0D, 0xCB, 0xB6, 0x75, 0x9A, 0xAA, 0x3A, 0x02, 0x49, 0x90, 0xD5, 0x20],
        [0xC8, 0xF3, 0x6F, 0x80, 0x22, 0xB5, 0x7F, 0xE9, 0x61, 0x95, 0xEF, 0xFE, 0x42, 0x2D, 0x43, 0xCA],
        [0x41, 0x24, 0xD4, 0x41, 0x7B, 0x1B, 0x9D, 0xB1, 0x4E, 0x02, 0xE3, 0x79, 0xD1, 0x51, 0xB7, 0x9E],
        [0x32, 0x5F, 0x70, 0x18, 0x1F, 0x65, 0xC3, 0xE6, 0xF4, 0x91, 0xFC, 0x29, 0x15, 0x23, 0xAE, 0x2F],
        [0xBA, 0x79, 0xF7, 0xF5, 0x8B, 0xE0, 0xCE, 0x7E, 0xB5, 0x4A, 0xEA, 0xFB, 0xEA, 0xE1, 0xCC, 0x01],
        [0x36, 0x24, 0x62, 0x92, 0x58, 0x0F, 0x49, 0x75, 0x21, 0xFB, 0x78, 0x7E, 0x12, 0xEB, 0x10, 0xDC],
        [0x01, 0x1E, 0x90, 0x29, 0xCF, 0x0F, 0x15, 0x34, 0x3D, 0x5D, 0x7C, 0x65, 0x36, 0xAC, 0xFD, 0x78],
        [0x85, 0x3A, 0x30, 0x4C, 0x3C, 0xCE, 0xAD, 0x35, 0xCB, 0x08, 0x0F, 0x46, 0x65, 0x78, 0xD5, 0x33],
        [0xDB, 0x95, 0x63, 0x40, 0x7D, 0x1D, 0xED, 0x32, 0x25, 0x65, 0xF2, 0x9B, 0x01, 0x37, 0x87, 0xC7],
        [0xBF, 0x57, 0x8F, 0xAB, 0x60, 0x78, 0x67, 0xA9, 0x1F, 0xC5, 0xBD, 0x1D, 0x93, 0xAD, 0x0F, 0xF9],
        [0x28, 0xE8, 0x30, 0x90, 0xDD, 0x22, 0x82, 0x0D, 0x64, 0x9A, 0x7D, 0x17, 0xAF, 0xF5, 0xC1, 0x34],
        [0x2B, 0xFF, 0x7C, 0xD1, 0x41, 0xE4, 0xE2, 0x60, 0x31, 0x55, 0x2F, 0x32, 0xFE, 0xAE, 0xCD, 0x36],
        [0xF3, 0x88, 0x25, 0x8A, 0x05, 0x0B, 0xC7, 0xF6, 0x90, 0x75, 0x50, 0xA5, 0xF9, 0x6A, 0x88, 0xE0],
        [0xFE, 0xE8, 0x68, 0x43, 0xDF, 0x58, 0x1B, 0x31, 0x25, 0xDD, 0x45, 0x42, 0x8B, 0x3A, 0x89, 0xAF],
        [0xFB, 0x6E, 0xD1, 0xEC, 0x50, 0x56, 0x5E, 0x46, 0x8A, 0xF3, 0x26, 0xAD, 0x06, 0xED, 0x65, 0x31],
        [0x62, 0x54, 0xEA, 0xDB, 0x50, 0x94, 0x31, 0x73, 0x57, 0xC5, 0xF1, 0x48, 0x33, 0xCA, 0x62, 0xBC],
        [0x9B, 0x59, 0xDE, 0x5B, 0x1B, 0xA7, 0x99, 0x96, 0x75, 0xA5, 0x1B, 0xD5, 0x71, 0xF3, 0x91, 0x82]]

    for length, index in lengths
    {
        let input = data[1 until length + 1]
        let tag   = expect Crypto.Poly1305.compute(key, input)
        Swag.require(Crypto.constantTimeEqual(tag, expected[index]))

        var mac = expect Crypto.Poly1305.create(key)
        mac.update(input[until 9])
        mac.update(input[9 until length - 1])
        mac.update(input[length - 1 until length])
        let streamed = mac.finalize()
        Swag.require(Crypto.constantTimeEqual(streamed, expected[index]))
    }
}

// OpenSSL tags for two-lane products with maximal clamped limbs and unaligned input.
#test
{
    var key:  [Crypto.Poly1305KeySize] u8
    var data: [4098] u8
    Swag.memset(key.buffer, 0xFF, key.count)
    Swag.memset(data.buffer, 0xFF, data.count)

    let lengths: [19] u64 = [127, 128, 129, 159, 160, 161, 255, 256, 319, 320, 321, 335, 336, 337, 351, 352, 353, 1023, 4097]
    let expected: [19] Crypto.Poly1305Tag = [
        [0xFD, 0xAA, 0xCA, 0xF2, 0x15, 0x6C, 0x73, 0x08, 0xA7, 0xE5, 0x9C, 0x44, 0xF4, 0x80, 0x96, 0x8A],
        [0xF8, 0xAA, 0xA2, 0x24, 0x0C, 0x6C, 0x4B, 0x3A, 0x9D, 0xE5, 0x74, 0x76, 0xEA, 0x80, 0x6E, 0xB4],
        [0x14, 0x94, 0x37, 0x24, 0xA3, 0xB2, 0xEA, 0x6E, 0x43, 0xD7, 0xF2, 0x24, 0x7F, 0x56, 0x74, 0xE9],
        [0x99, 0x51, 0x75, 0xD8, 0x63, 0x9B, 0x48, 0x6A, 0x74, 0x3D, 0xF8, 0x72, 0x00, 0x4E, 0xBD, 0x84],
        [0x99, 0x51, 0x4D, 0x0A, 0x5A, 0x9B, 0x20, 0x9C, 0x6A, 0x3D, 0xD0, 0xA4, 0xF6, 0x4D, 0x95, 0xAE],
        [0x47, 0x70, 0x98, 0x9B, 0x93, 0xAD, 0x09, 0x85, 0xC2, 0x4E, 0x78, 0x99, 0x67, 0x8D, 0xC9, 0x8A],
        [0xC8, 0x0C, 0xB4, 0x38, 0x44, 0xF3, 0x87, 0x94, 0x6E, 0x5A, 0xA6, 0x08, 0x5B, 0xDF, 0x67, 0xDA],
        [0xC3, 0x0C, 0x8C, 0x6A, 0x3A, 0xF3, 0x5F, 0xC6, 0x64, 0x5A, 0x7E, 0x3A, 0x51, 0xDF, 0x3F, 0x04],
        [0xE2, 0x52, 0x0A, 0xC0, 0x43, 0xF0, 0x39, 0x03, 0x81, 0xE2, 0x0A, 0x86, 0x73, 0x5D, 0x64, 0xC8],
        [0xDD, 0x52, 0xE2, 0xF1, 0x39, 0xF0, 0x11, 0x35, 0x77, 0xE2, 0xE2, 0xB7, 0x69, 0x5D, 0x3C, 0xF2],
        [0xFA, 0x40, 0x7D, 0xEA, 0xE9, 0x79, 0x56, 0x01, 0x58, 0xEB, 0xD7, 0x64, 0x0F, 0x2E, 0x41, 0x5F],
        [0xD2, 0x42, 0xA5, 0xE0, 0xC9, 0x81, 0x7E, 0xF7, 0x37, 0xF3, 0xFF, 0x5A, 0xEF, 0x35, 0x69, 0x5D],
        [0xCD, 0x42, 0x7D, 0x12, 0xC0, 0x81, 0x56, 0x29, 0x2E, 0xF3, 0xD7, 0x8C, 0xE5, 0x35, 0x41, 0x87],
        [0xC4, 0xE7, 0x92, 0x48, 0x42, 0x2B, 0x2B, 0xB6, 0xB3, 0x18, 0xE2, 0xB4, 0xF2, 0xB6, 0x2B, 0x95],
        [0x9C, 0xE9, 0xBA, 0x3E, 0x22, 0x33, 0x53, 0xAC, 0x93, 0x20, 0x0A, 0xAB, 0xD2, 0xBE, 0x53, 0x93],
        [0x97, 0xE9, 0x92, 0x70, 0x18, 0x33, 0x2B, 0xDE, 0x89, 0x20, 0xE2, 0xDC, 0xC8, 0xBE, 0x2B, 0xBD],
        [0x24, 0xA8, 0x7F, 0x3C, 0x0A, 0x66, 0xB1, 0x01, 0x1C, 0xA2, 0x3F, 0xB3, 0x1F, 0xB3, 0xD4, 0xED],
        [0x25, 0xD4, 0xBA, 0x38, 0x5D, 0xBB, 0x70, 0xDB, 0xAB, 0x28, 0x14, 0x30, 0xEA, 0xA3, 0x42, 0x0E],
        [0xF9, 0x7F, 0x46, 0xE7, 0x06, 0xDD, 0x5C, 0x90, 0xF9, 0x2E, 0x7E, 0xE2, 0x01, 0xA5, 0xC4, 0x3C]]

    for length, index in lengths
    {
        let input = data[1 until length + 1]
        let tag   = expect Crypto.Poly1305.compute(key, input)
        Swag.require(Crypto.constantTimeEqual(tag, expected[index]))

        var mac = expect Crypto.Poly1305.create(key)
        mac.update(input[until 17])
        mac.update(input[17 until length - 1])
        mac.update(input[length - 1 until length])
        Swag.require(Crypto.constantTimeEqual(mac.finalize(), expected[index]))
    }
}

// Check tile concatenation, including a prior accumulator and a partial final block.
#[Swag.TestTag("parallel")]
#test
{
    Swag.setWorkerCount(4)
    const Tile = 128 * 1024
    var key: [Crypto.Poly1305KeySize] u8
    for index in key.count
    {
        key[index] = cast(u8, (index * 61 + 249) & 255)
    }

    var data: Array!{u8}
    data.resize(3 * Tile + 50)
    Memory.set(data.storage(), 0xFF, data.count)
    let lengths:  [5] u64 = [2 * Tile - 1, 2 * Tile, 2 * Tile + 1, 2 * Tile + 64, 3 * Tile + 49]
    let expected: [5] Crypto.Poly1305Tag = [
        [0x46, 0x3B, 0xA4, 0xF8, 0x5D, 0x6C, 0x55, 0x33, 0x10, 0x60, 0xDB, 0xDF, 0x26, 0xDA, 0x16, 0x46],
        [0xB0, 0x24, 0xC3, 0xAB, 0xC0, 0x55, 0x4C, 0x0E, 0x73, 0x49, 0xAA, 0xE2, 0x89, 0xC3, 0xBD, 0x72],
        [0xFF, 0x88, 0xF6, 0x60, 0xC9, 0x7A, 0x6C, 0x46, 0xAF, 0xD0, 0x5E, 0xCE, 0x61, 0xA2, 0x14, 0x33],
        [0x9D, 0xC4, 0xCE, 0xB3, 0x3F, 0x66, 0xB6, 0xC1, 0xE0, 0x89, 0x4A, 0xD8, 0x11, 0xE0, 0x8B, 0xF3],
        [0x8E, 0x9E, 0x24, 0x36, 0x91, 0x53, 0xE2, 0xB2, 0x5F, 0x36, 0xFB, 0x6D, 0xF6, 0x75, 0xDB, 0xE2]]

    for length, index in lengths
    {
        let input  = data.toSlice()[1 until length + 1]
        let direct = expect Crypto.Poly1305.compute(key, input)
        Swag.require(Crypto.constantTimeEqual(direct, expected[index]))

        var mac = expect Crypto.Poly1305.create(key)
        mac.update(input[until 17])
        mac.update(input[17 until length - 5])
        mac.update(input[length - 5 until length])
        let streamed = mac.finalize()
        Swag.require(Crypto.constantTimeEqual(streamed, expected[index]))
    }
}

// Reset validation preserves the active one-time key state on failure, while a
// successful reset starts a fresh message under the replacement key.
#test
{
    let firstKey  = rangeBytes(32, 0x10)
    let secondKey = rangeBytes(32, 0x80)
    var mac       = expect Crypto.Poly1305.create(firstKey.toSlice())
    mac.update("discarded prefix")

    var shortResetOutcome: Swag.Error
    discard catch mac.reset(secondKey.toSlice()[until 31]) as shortResetOutcome
    Swag.require(shortResetOutcome.value() is Errors.BadParameterError)

    mac.update(" + kept suffix")
    let preserved = mac.finalize()
    let preservedReference = expect Crypto.Poly1305.compute(firstKey.toSlice(), "discarded prefix + kept suffix")
    Swag.require(Crypto.constantTimeEqual(preserved, preservedReference))

    expect mac.reset(secondKey.toSlice())
    mac.update("fresh message")
    let resetTag       = mac.finalize()
    let resetReference = expect Crypto.Poly1305.compute(secondKey.toSlice(), "fresh message")
    Swag.require(Crypto.constantTimeEqual(resetTag, resetReference))

    expect mac.reset(firstKey.toSlice())
    mac.update("another discarded prefix")
    expect mac.reset(secondKey.toSlice())
    mac.update("fresh message")
    let replacementTag = mac.finalize()
    Swag.require(Crypto.constantTimeEqual(replacementTag, resetReference))
}

#test
{
    // RFC 8439 section 2.8.2, the full AEAD vector.
    let plaintext      = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
    let key            = rangeBytes(32, 0x80)
    let associatedData: [12] u8 = [0x50, 0x51, 0x52, 0x53, 0xC0, 0xC1, 0xC2, 0xC3, 0xC4, 0xC5, 0xC6, 0xC7]
    let nonce: [12] u8 = [0x07, 0x00, 0x00, 0x00, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47]

    var ciphertext: Array!{u8}
    ciphertext.resize(plaintext.count)
    var tag: [Crypto.ChaCha20Poly1305TagSize] u8
    expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce, plaintext, associatedData, ciphertext.toSlice(), tag)

    let expectedTag: [16] u8 = [
        0x1A, 0xE1, 0x0B, 0x59, 0x4F, 0x09, 0xE2, 0x6A,
        0x7E, 0x90, 0x2E, 0xCB, 0xD0, 0x60, 0x06, 0x91]
    Swag.require(Crypto.constantTimeEqual(tag, expectedTag))

    let expectedHead: [16] u8 = [
        0xD3, 0x1A, 0x8D, 0x34, 0x64, 0x8E, 0x60, 0xDB,
        0x7B, 0x86, 0xAF, 0xBC, 0x53, 0xEF, 0x7E, 0xC2]
    Swag.require(Crypto.constantTimeEqual(ciphertext.toSlice()[0 until 16], expectedHead))

    var opened: Array!{u8}
    opened.resize(plaintext.count)
    Swag.require(expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce, ciphertext.toSlice(), tag, associatedData, opened.toSlice()))
    Swag.require(Crypto.constantTimeEqual(opened.toSlice(), plaintext))
}

#test
{
    // Every input the tag covers must be able to reject the record, and a
    // rejected record must leave the destination untouched.
    let key            = rangeBytes(32, 0x11)
    let nonce          = rangeBytes(12, 0x22)
    let associatedData = rangeBytes(9, 0x33)
    let plaintext      = rangeBytes(70, 0x44)

    var ciphertext: Array!{u8}
    ciphertext.resize(plaintext.count)
    var tag: [Crypto.ChaCha20Poly1305TagSize] u8
    expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce.toSlice(), plaintext.toSlice(), associatedData.toSlice(), ciphertext.toSlice(), tag)
    Swag.require(not Crypto.constantTimeEqual(ciphertext.toSlice(), plaintext.toSlice()))

    var opened: Array!{u8}
    opened.resize(plaintext.count)
    Swag.require(expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, associatedData.toSlice(), opened.toSlice()))
    Swag.require(Crypto.constantTimeEqual(opened.toSlice(), plaintext.toSlice()))

    ciphertext[0] ^= 1
    Swag.require(not (expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, associatedData.toSlice(), opened.toSlice())))
    ciphertext[0] ^= 1

    Memory.set(opened.storage(), 0xA5, opened.count)
    tag[0] ^= 1
    Swag.require(not (expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, associatedData.toSlice(), opened.toSlice())))
    for value in opened.toSlice()
    {
        Swag.require(value == 0xA5)
    }

    tag[0] ^= 1

    let otherAssociated = rangeBytes(9, 0x34)
    Swag.require(not (expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, otherAssociated.toSlice(), opened.toSlice())))

    let otherNonce = rangeBytes(12, 0x23)
    Swag.require(not (expect Crypto.chacha20Poly1305Open(key.toSlice(), otherNonce.toSlice(), ciphertext.toSlice(), tag, associatedData.toSlice(), opened.toSlice())))

    let otherKey = rangeBytes(32, 0x12)
    Swag.require(not (expect Crypto.chacha20Poly1305Open(otherKey.toSlice(), nonce.toSlice(), ciphertext.toSlice(), tag, associatedData.toSlice(), opened.toSlice())))

    // An empty payload is still authenticated, which is what a metadata-only
    // record relies on.
    var emptyPayload: Array!{u8}
    var emptyTag:     [Crypto.ChaCha20Poly1305TagSize] u8
    expect Crypto.chacha20Poly1305Seal(key.toSlice(), nonce.toSlice(), "", associatedData.toSlice(), emptyPayload.toSlice(), emptyTag)
    Swag.require(expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), "", emptyTag, associatedData.toSlice(), emptyPayload.toSlice()))
    emptyTag[15] ^= 0x80
    Swag.require(not (expect Crypto.chacha20Poly1305Open(key.toSlice(), nonce.toSlice(), "", emptyTag, associatedData.toSlice(), emptyPayload.toSlice())))
}
