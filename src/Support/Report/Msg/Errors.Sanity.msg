SWC_DIAG_DEF(sanity_err_division_zero, Error, "divisor is zero; [help] use a nonzero divisor")
SWC_DIAG_DEF(sanity_err_out_of_bounds, Error, "memory access starts outside the variable's bounds; [help] keep the access within the variable's bounds")
SWC_DIAG_DEF(sanity_err_integer_overflow, Error, "signed division of the minimum value by -1 overflows; [help] handle the minimum value before dividing it or taking its remainder by -1")
SWC_DIAG_DEF(sanity_err_invalid_argument, Error, "argument to '{sym}' is outside its domain; [help] '{sym}' requires {what}")
SWC_DIAG_DEF(sanity_err_null_deref, Error, "cannot dereference a null pointer; [help] assign a live address before dereferencing the pointer")
SWC_DIAG_DEF(sanity_err_null_call, Error, "cannot call a null function pointer; [help] assign a function before calling the pointer")
SWC_DIAG_DEF(sanity_err_return_local_address, Error, "cannot return the address of a local variable; [help] return caller-owned or heap-allocated storage")
SWC_DIAG_DEF(sanity_err_use_after_move, Error, "cannot read a moved-from value; [help] assign the value before reading it")
SWC_DIAG_DEF(sanity_err_undefined_read, Error, "cannot read an uninitialized value; [help] assign the value before reading it")
SWC_DIAG_DEF(sanity_err_free_borrowed, Error, "cannot free data borrowed from local variable '{sym}'; [help] allocate owned heap storage before calling 'free'")
SWC_DIAG_DEF(sanity_err_use_after_free, Error, "cannot dereference a pointer to released memory; [help] assign a live address before dereferencing the pointer")
SWC_DIAG_DEF(sanity_err_double_free, Error, "cannot free a pointer to released memory; [help] remove the repeated release, or assign a live allocation before freeing the pointer")
SWC_DIAG_DEF(sanity_err_borrow_escape, Error, "borrowed data from local variable '{sym}' escapes through {what}; [help] copy the data or keep '{sym}' alive longer")
SWC_DIAG_DEF(sanity_err_borrow_scope_escape, Error, "borrowed data from local variable '{sym}' does not live as long as '{value}'; [help] declare '{sym}' in a scope that outlives '{value}', or copy the data")
SWC_DIAG_DEF(sanity_err_borrow_temporary, Error, "borrowed data from a temporary value escapes through {what}; [help] store the temporary in a variable that lives long enough")
SWC_DIAG_DEF(sanity_err_borrow_materialized, Error, "borrowed data backed by function-local storage escapes through {what}; [help] copy the data into caller-owned storage")
SWC_DIAG_DEF(sanity_err_collection_mutated, Error, "'{value}' structurally modifies '{sym}' during its iteration; [help] break out of the loop before calling '{value}', or apply the changes after iteration")
SWC_DIAG_DEF(sanity_err_borrow_invalidated, Error, "'{value}' structurally modifies '{sym}' while '{what}' refers to its storage; [help] take '{what}' again after '{value}', or copy the data")
SWC_DIAG_DEF(sanity_err_context_escape, Error, "'@setcontext' stores a pointer to local variable '{sym}' beyond its frame; [help] save the previous context, then restore it with 'defer @setcontext(prev)'")
