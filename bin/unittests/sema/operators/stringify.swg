#global private

#assert("truetrue" == #stringof("true", "true"))
#assert("truetrue" == #stringof("true", true))
#assert("truefalse" == #stringof("true", false))
#assert("falsetrue" == #stringof(false, "true"))
#assert("falsefalse" == #stringof(false, false))

#assert(#stringof(1, 2) == "12")
#assert(#stringof(1's32, 2) == "12")
#assert(#stringof(1's8, 2) == "12")
#assert(#stringof(1's16, 2) == "12")
#assert(#stringof(1's64, 2) == "12")
#assert(#stringof(1'u8, 2) == "12")
#assert(#stringof(1'u16, 2) == "12")
#assert(#stringof(1'u32, 2) == "12")
#assert(#stringof(1'u64, 2) == "12")

#assert(#stringof(-1's32, 0) == "-10")
#assert(#stringof(-1's8, 0) == "-10")
#assert(#stringof(-1's16, 0) == "-10")
#assert(#stringof(-1's64, 0) == "-10")
#assert(#stringof(-1234's32, 0) == "-12340")
#assert(#stringof(-1234's64, 0) == "-12340")

#assert(#stringof(0, 0) == "00")
#assert(#stringof(3, 3) == "33")
#assert(#stringof(10, 20) == "1020")
#assert(#stringof(255'u8, 1) == "2551")
#assert(#stringof(65535'u16, 0) == "655350")

#assert(#stringof(1.5645789'f32, 0) == "1.56457890")
#assert(#stringof(1.5645789'f64, 0) == "1.56457889999999990")
#assert(#stringof(0.0'f32, 0) == "00")
#assert(#stringof(0.0'f64, 0) == "00")
#assert(#stringof(-1.0'f32, 0) == "-10")
#assert(#stringof(-1.0'f64, 0) == "-10")

#assert("123" == #stringof(1, "23"))
#assert("false-1" == #stringof(false, -1))
#assert("true-1" == #stringof(true, -1))
#assert(#stringof("A", "B") == "AB")
#assert(#stringof("A", "") == "A")
#assert(#stringof("", "B") == "B")
#assert("1" == #stringof(1, ""))
#assert(#stringof("", "") == "")
#assert(#stringof('a', 'a') == "aa")
#assert(#stringof('A', "") == "A")
#assert(#stringof("", 'Z') == "Z")
#assert(#stringof('😀', '😀') == "😀😀")
