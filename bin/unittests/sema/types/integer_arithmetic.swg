#global private

#assert(1 + 1 == 2)
#assert(1_s32 + 1 == 2)
#assert(1_s8 + 1 == 2)
#assert(1_s16 + 1 == 2)
#assert(1_s64 + 1 == 2)
#assert(1_u32 + 1 == 2)
#assert(1_u8 + 1 == 2)
#assert(1_u16 + 1 == 2)
#assert(1_u64 + 1 == 2)
#assert(127_s8 + 0 == 127)
#assert(32767_s16 + 0 == 32767)
#assert(2147483647_s32 + 0 == 2147483647)
#assert(9223372036854775807_s64 + 0 == 9223372036854775807)
#assert(255_u8 + 0 == 255)
#assert(65535_u16 + 0 == 65535)
#assert(4294967295_u32 + 0 == 4294967295)
#assert(18446744073709551615_u64 + 0 == 18446744073709551615_u64)

#assert(2 - 1 == 1)
#assert(2_s32 - 1 == 1)
#assert(2_s8 - 1 == 1)
#assert(2_s16 - 1 == 1)
#assert(2_s64 - 1 == 1)
#assert(2_u32 - 1 == 1)
#assert(2_u8 - 1 == 1)
#assert(2_u16 - 1 == 1)
#assert(2_u64 - 1 == 1)
#assert(0 - 2 == -2)
#assert(0_s32 - 2 == -2)
#assert(0_s8 - 2 == -2)
#assert(0_s16 - 2 == -2)
#assert(0_s64 - 2 == -2)
#assert(10_u16 - 3 == 7)
#assert(10_u8 - 3 == 7)
#assert(10_u32 - 3 == 7)
#assert(10_u64 - 3 == 7)
#assert(2 - 4 == -2)

#assert(2 * 2 == 4)
#assert(2_s32 * 2 == 4)
#assert(2_s8 * 2 == 4)
#assert(2_s16 * 2 == 4)
#assert(2_s64 * 2 == 4)
#assert(2_u32 * 2 == 4)
#assert(2_u8 * 2 == 4)
#assert(2_u16 * 2 == 4)
#assert(2_u64 * 2 == 4)
#assert(3_s16 * 4 == 12)
#assert(3_s8 * 4 == 12)
#assert(3_s32 * 4 == 12)
#assert(3_s64 * 4 == 12)
#assert(3_u8 * 4 == 12)
#assert(3_u16 * 4 == 12)
#assert(3_u32 * 4 == 12)
#assert(3_u64 * 4 == 12)

func semaTest001()
{
    let value: u32 = 3
    let scale: u64 = 1000
    let millis0    = value * scale
    let millis1    = scale * value
    #assert(#typeof(millis0) == u64)
    #assert(#typeof(millis1) == u64)
    #assert(millis0 == 3000_u64)
    #assert(millis1 == 3000_u64)
}

#assert(4 / 2 == 2)
#assert(4_s32 / 2 == 2)
#assert(4_s8 / 2 == 2)
#assert(4_s16 / 2 == 2)
#assert(4_s64 / 2 == 2)
#assert(4_u32 / 2 == 2)
#assert(4_u8 / 2 == 2)
#assert(4_u16 / 2 == 2)
#assert(4_u64 / 2 == 2)
#assert(-4_s32 / 2 == -2)
#assert(-4_s8 / 2 == -2)
#assert(-4_s16 / 2 == -2)
#assert(-4_s64 / 2 == -2)

#assert(127_s8 + #wrap 1 == 128)
#assert(127_s8 + #prom 1 == 128)
#assert('A'_rune + #wrap 1 == 'B'_rune)

#assert(1 | 2 == 3)
#assert(1 & 2 == 0)
#assert(1 & 1 == 1)
#assert(1 ^ 1 == 0)
#assert(1 ^ 0 == 1)
#assert(1_u8 | 2_u8 == 3_u8)
#assert(1_u16 | 2_u16 == 3_u16)
#assert(1_u32 | 2_u32 == 3_u32)
#assert(1_u64 | 2_u64 == 3_u64)
#assert(1_u8 & 2_u8 == 0_u8)
#assert(1_u16 & 2_u16 == 0_u16)
#assert(1_u32 & 2_u32 == 0_u32)
#assert(1_u64 & 2_u64 == 0_u64)
#assert(1_u8 ^ 1_u8 == 0_u8)
#assert(1_u16 ^ 1_u16 == 0_u16)
#assert(1_u32 ^ 1_u32 == 0_u32)
#assert(1_u64 ^ 1_u64 == 0_u64)
#assert(0xFF_u8 & 0x01_u8 == 1)
#assert(0b1010 ^ 0b0110 == 0b1100)
#assert(0b1111 | 0b0000 == 0b1111)

#assert(1 << 1 == 2)
#assert(1_s32 << 1 == 2)
#assert(1_s8 << 1 == 2)
#assert(1_s16 << 1 == 2)
#assert(1_s64 << 1 == 2)
#assert(1_u32 << 1 == 2)
#assert(1_u8 << 1 == 2)
#assert(1_u16 << 1 == 2)
#assert(1_u64 << 1 == 2)
#assert(1_u8 << 7 == 128)

#assert(8 >> 1 == 4)
#assert(8_s32 >> 1 == 4)
#assert(8_s8 >> 1 == 4)
#assert(8_s16 >> 1 == 4)
#assert(8_s64 >> 1 == 4)
#assert(8_u32 >> 1 == 4)
#assert(8_u8 >> 1 == 4)
#assert(8_u16 >> 1 == 4)
#assert(8_u64 >> 1 == 4)
#assert(1_u8 >> 1 == 0)
#assert(2_s8 >> 1 == 1)
#assert(1_s8 >> 1 == 0)
#assert(-2_s8 >> 1 == -1)
#assert(-128_s8 >> 1 == -64)
#assert(255_u8 >> 1 == 127)
#assert(128_u8 >> 1 == 64)

// The largest valid amount is one below the width; a sized value never shifts by its width.
#assert(1_u8 >> 7 == 0)
#assert(0_u16 >> 15 == 0)
#assert(0_u32 >> 31 == 0)
#assert(0_u64 >> 63 == 0)
#assert((-1_s8) >> 7 == -1)
#assert((-1_s16) >> 15 == -1)
#assert((-1_s32) >> 31 == -1)
#assert((-1_s64) >> 63 == -1)
#assert((-5_s32) >> 31 == -1)
#assert((-5_s64) >> 63 == -1)
#assert(5_s32 >> 31 == 0)
#assert(5_s64 >> 63 == 0)
#assert(0x80_u8 >> 7 == 1_u8)

// An unsized constant has no width to exceed.
#assert((1 << 100) >> 98 == 4)
#assert(5 >> 100 == 0)

#assert(#typeof(1_u8 << 7) == u8)
#assert(#typeof(1_u16 << 15) == u16)
#assert(1_u8 << 7 == 0x80_u8)
#assert(3_u8 << 7 == 0x80_u8)
#assert(1_u16 << 15 == 0x8000_u16)
#assert(1_u32 << 31 == 0x80000000_u32)
#assert(1_u64 << 63 == 0x80000000_00000000_u64)
#assert(5_s8 << 7 == -128_s8)
#assert(5_s16 << 15 == -32768_s16)
#assert(5_s32 << 31 == -2147483648_s32)
#assert((-1_s8) << 7 == -128_s8)
#assert((-1_s16) << 15 == -32768_s16)
#assert((-1_s32) << 31 == -2147483648_s32)

#assert(3 % 4 == 3)
#assert(-7 % 3 == -1)
#assert(7 % -3 == 1)
#assert(-7 % -3 == -1)
#assert(0 % 5 == 0)
#assert(10 % 3 == 1)
#assert(10_s8 % 3 == 1)
#assert(10_s16 % 3 == 1)
#assert(10_s32 % 3 == 1)
#assert(10_s64 % 3 == 1)
#assert(10_u8 % 3 == 1)
#assert(10_u16 % 3 == 1)
#assert(10_u32 % 3 == 1)
#assert(10_u64 % 3 == 1)
#assert(10_u32 % 3_u32 == 1)
#assert(10_u64 % 3_u64 == 1)

const DivOverflowS8  = -128_s8 / -1
const DivOverflowS16 = -32768_s16 / -1
