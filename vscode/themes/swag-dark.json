{
	"$schema": "vscode://schemas/color-theme",
	"name": "Swag Dark",
	"colors": {
		"foreground": "#E6E6EA",
		"disabledForeground": "#7D7D89",
		"descriptionForeground": "#A9A9B4",
		"icon.foreground": "#E6E6EA",
		"focusBorder": "#F7F900",
		"selection.background": "#2A2A30",
		"widget.border": "#26262E",
		"sash.hoverBorder": "#F7F900",
		"editor.background": "#0E0E11",
		"editor.foreground": "#D5D5DD",
		"editor.lineHighlightBackground": "#16161C",
		"editor.selectionBackground": "#2A2A30",
		"editor.selectionHighlightBackground": "#F7F90018",
		"editor.inactiveSelectionBackground": "#202024",
		"editorCursor.foreground": "#F7F900",
		"editorLineNumber.foreground": "#4A4A56",
		"editorLineNumber.activeForeground": "#F7F900",
		"editorIndentGuide.background1": "#20202A",
		"editorIndentGuide.activeBackground1": "#3A3A48",
		"editorWhitespace.foreground": "#26262E",
		"editorRuler.foreground": "#20202A",
		"editorBracketMatch.background": "#F7F90020",
		"editorBracketMatch.border": "#F7F90070",
		"editorError.foreground": "#FF6666",
		"editorWarning.foreground": "#E0B464",
		"sideBar.background": "#0B0B0D",
		"sideBar.border": "#26262E",
		"sideBarTitle.foreground": "#9A9AA6",
		"activityBar.background": "#0B0B0D",
		"activityBar.foreground": "#E6E6EA",
		"activityBar.inactiveForeground": "#7D7D89",
		"activityBar.border": "#26262E",
		"activityBar.activeBorder": "#F7F900",
		"activityBarBadge.background": "#F7F900",
		"activityBarBadge.foreground": "#050505",
		"statusBar.background": "#050505",
		"statusBar.foreground": "#C9C9CF",
		"statusBarItem.remoteBackground": "#F7F900",
		"statusBarItem.remoteForeground": "#050505",
		"titleBar.activeBackground": "#050505",
		"titleBar.activeForeground": "#E6E6EA",
		"tab.activeBackground": "#0E0E11",
		"tab.activeForeground": "#E6E6EA",
		"tab.activeBorderTop": "#F7F900",
		"tab.inactiveBackground": "#0B0B0D",
		"tab.inactiveForeground": "#7D7D89",
		"list.dropBackground": "#202024",
		"list.activeSelectionBackground": "#2A2A30",
		"list.activeSelectionForeground": "#E6E6EA",
		"list.activeSelectionIconForeground": "#F7F900",
		"list.inactiveSelectionBackground": "#202024",
		"list.inactiveSelectionForeground": "#A9A9B4",
		"list.hoverBackground": "#202024",
		"list.hoverForeground": "#E6E6EA",
		"list.focusBackground": "#202024",
		"list.focusForeground": "#E6E6EA",
		"list.focusOutline": "#F7F900",
		"list.focusAndSelectionOutline": "#F7F900",
		"toolbar.hoverBackground": "#202024",
		"toolbar.hoverOutline": "#26262E",
		"toolbar.activeBackground": "#2A2A30",
		"actionBar.toggledBackground": "#2A2A30",
		"panel.border": "#26262E",
		"panelTitle.activeBorder": "#F7F900",
		"input.placeholderForeground": "#7D7D89",
		"input.background": "#16161C",
		"input.foreground": "#E6E6EA",
		"input.border": "#26262E",
		"dropdown.background": "#16161C",
		"dropdown.foreground": "#E6E6EA",
		"dropdown.border": "#26262E",
		"button.background": "#F7F900",
		"button.foreground": "#0B0B0D",
		"button.hoverBackground": "#F7F900",
		"button.secondaryBackground": "#202024",
		"button.secondaryForeground": "#E6E6EA",
		"button.secondaryHoverBackground": "#2A2A30",
		"settings.textInputBackground": "#16161C",
		"settings.numberInputBackground": "#16161C",
		"menu.background": "#16161C",
		"menu.foreground": "#D5D5DD",
		"menu.selectionBackground": "#202024",
		"menu.selectionForeground": "#E6E6EA",
		"menu.selectionBorder": "#F7F900",
		"menu.separatorBackground": "#26262E",
		"menu.border": "#26262E",
		"menubar.selectionBackground": "#202024",
		"menubar.selectionForeground": "#E6E6EA",
		"menubar.selectionBorder": "#F7F900",
		"terminal.selectionBackground": "#2A2A30",
		"terminal.inactiveSelectionBackground": "#202024",
		"editorBracketHighlight.foreground1": "#D5D5DD",
		"editorBracketHighlight.foreground2": "#E0B464",
		"editorBracketHighlight.foreground3": "#C48FD0",
		"editorBracketHighlight.foreground4": "#56C2B3",
		"editorBracketHighlight.foreground5": "#9EC98F",
		"editorBracketHighlight.foreground6": "#9A9AA6"
	},
	"tokenColors": [
		{
			"scope": "comment",
			"settings": {
				"foreground": "#7AA86A"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#E8A06A"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "keyword.control",
			"settings": {
				"foreground": "#C48FD0"
			}
		},
		{
			"scope": "keyword.declaration",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#D5D5DD"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"entity.name.function.op"
			],
			"settings": {
				"foreground": "#E8A06A"
			}
		},
		{
			"scope": "entity.name.function.intrinsic",
			"settings": {
				"foreground": "#CBB45C"
			}
		},
		{
			"scope": "entity.name.namespace.builtin.swag",
			"settings": {
				"foreground": "#94A3B8"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#FF6666"
			}
		},
		{
			"scope": [
				"meta.preprocessor",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#9A9AA6"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class"
			],
			"settings": {
				"foreground": "#56C2B3"
			}
		},
		{
			"scope": "storage.type",
			"settings": {
				"foreground": "#E0B464"
			}
		},
		{
			"scope": "storage.modifier",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#9EC98F"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#E0937C"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#CBB45C"
			}
		},
		{
			"scope": "source.code",
			"settings": {
				"foreground": "#D5D5DD"
			}
		}
	]
}
