#import("core", location: "swag@std")

#load("args.swg")
#load("context.swg")
#load("scope.swg")
#load("suites.swg")
#load("workspaces.swg")
#load("campaign.swg")
#load("maintenance.swg")
#load("usage.swg")

using Core

// Every project-owned entry point of this repository, in one program.
//
// The batch files beside this one are shims: each names itself, hands its raw command line over,
// and does nothing else. They are still batch because something has to find the pinned compiler
// before any Swag code can run, and because a repository tool has to stay reachable from a plain
// shell with nothing set up.
#main
{
    let name = Env.variable("SWAG_TOOL_NAME")
    let raw  = Env.variable("SWAG_TOOL_ARGS")

    let code = catch Tool.dispatch(name.toString(), raw.toString()) as err
    if err != null
    {
        @print("error: ", err, "\n")
        Env.exit(1)
    }

    if code != 0 do
        Env.exit(cast #bit (u32) code)
}

namespace Tool
{
    // Runs the tool `name` asks for and returns the exit code it produced.
    public func dispatch(name: string, rawArguments: string)->s32 fail
    {
        let tokens   = splitCommandLine(rawArguments)
        let accepted = acceptedCommands(name)

        var options = try parseOptions(accepted.toSlice(), tokens.toSlice())
        if options.wantHelp do
            return printUsage(name)

        var context = try Context.create(options)

        switch name
        {
        case "std":
            if options.command.isEmpty() do
                options.command = String.from("build")
            return try runStd(&context, &options)

        case "examples":
            return try runExamples(&context, &options)

        case "apps":
            return try runApps(&context, &options)

        case "reference":
            if options.command.isEmpty() do
                options.command = String.from("test")
            return try runReference(&context, &options)

        case "scripts":
            return try runScripts(&context, &options)

        case "unittests":
            return try runUnittests(&context, &options)

        case "tests":
            return try runTests(&context, &options)

        case "build":
            return try runBuild(&context, &options)

        case "format":
            return try runFormat(&context, &options)

        case "goldens":
            return try runGoldens(&context, &options)

        case "web":
            return try runWeb(&context, &options)

        case "scrypt":
            return try runScrypt(&context, &options)

        case "vsix":
            return try runVsix(&context, &options)

        case "setup":
            return try runSetup(&context, &options)

        case "bench":
            return try runBench(&context, &options)
        }

        @print("error: '", name, "' is not a repository tool\n")
        return 1
    }

    // Returns the commands one tool accepts as its first positional.
    //
    // Which words are commands is part of the grammar: a first positional the tool has no
    // command for is read as the module, suite, or script name instead.
    private func acceptedCommands(name: string)->Array'(string)
    {
        var result: retval

        switch name
        {
        case "std", "reference":
            result.add("build")
            result.add("test")

        case "examples", "apps":
            result.add("build")
            result.add("run")
            result.add("test")
            result.add("smoke")

        case "scripts":
            result.add("run")
            result.add("smoke")

        case "tests":
            result.add("changed")
            result.add("plan")
        }

        return result
    }
}
