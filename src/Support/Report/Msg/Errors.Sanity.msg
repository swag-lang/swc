SWC_DIAG_DEF(sanity_err_division_zero, Error, "the divisor is provably zero on this path; [help] handle the zero case before dividing or taking the remainder")
SWC_DIAG_DEF(sanity_err_out_of_bounds, Error, "memory access starts outside the variable's storage; [help] check the index and offset against the original allocation before accessing it")
SWC_DIAG_DEF(sanity_err_integer_overflow, Error, "signed division of the minimum value by -1 overflows; [help] handle the minimum value before dividing it or taking its remainder by -1")
SWC_DIAG_DEF(sanity_err_invalid_argument, Error, "argument to '{sym}' is outside its domain; [help] pass an argument that satisfies this domain: {what}")
SWC_DIAG_DEF(sanity_err_null_deref, Error, "cannot dereference a null pointer; [help] handle the null case before dereferencing, or obtain a live address on this path")
SWC_DIAG_DEF(sanity_err_null_call, Error, "cannot call a null function pointer; [help] handle the null case before calling, or assign a function on this path")
SWC_DIAG_DEF(sanity_err_return_local_address, Error, "cannot return the address of a local variable; [help] return the value itself, or return an address backed by storage that outlives the function")
SWC_DIAG_DEF(sanity_err_use_after_move, Error, "cannot read a moved-from value; [help] assign the value before reading it")
SWC_DIAG_DEF(sanity_err_write_after_move, Error, "cannot write through a pointer into moved-from storage; [help] rebind the pointer before writing through it")
SWC_DIAG_DEF(sanity_err_free_borrowed, Error, "cannot free data borrowed from local variable '{sym}'; [help] allocate owned heap storage before calling 'free'")
SWC_DIAG_DEF(sanity_err_free_global, Error, "cannot free a pointer to global storage; [help] release only a pointer the allocator returned")
SWC_DIAG_DEF(sanity_err_return_released, Error, "cannot return a pointer to released memory; [help] return a live allocation, or read the value out before the release")
SWC_DIAG_DEF(sanity_err_use_after_free, Error, "cannot dereference a pointer to released memory; [help] handle the null case before dereferencing, or obtain a live address on this path")
SWC_DIAG_DEF(sanity_warn_possible_use_after_free, Warning, "pointer may refer to released memory; [help] move the dereference before any release, or keep the allocation live on every path reaching it")
SWC_DIAG_DEF(sanity_err_double_free, Error, "cannot free a pointer to released memory; [help] remove the repeated release, or assign a live allocation before freeing the pointer")
SWC_DIAG_DEF(sanity_err_borrow_escape, Error, "borrowed data from local variable '{sym}' escapes through {what}; [help] copy the data or keep '{sym}' alive longer")
SWC_DIAG_DEF(sanity_err_borrow_scope_escape, Error, "destination '{value}' outlives the storage it borrows from '{sym}'; [help] declare '{sym}' in a scope that outlives '{value}', or copy the data")
SWC_DIAG_DEF(sanity_err_borrow_temporary, Error, "borrowed data from a temporary value escapes through {what}; [help] keep the owner in a scope that outlives the borrow, or return or store an owned copy")
SWC_DIAG_DEF(sanity_err_borrow_materialized, Error, "borrowed data backed by function-local storage escapes through {what}; [help] copy the data into caller-owned storage")
SWC_DIAG_DEF(sanity_err_collection_mutated, Error, "'{value}' structurally modifies '{sym}' during its iteration; [help] break out of the loop before calling '{value}', or apply the changes after iteration")
SWC_DIAG_DEF(sanity_err_borrow_invalidated, Error, "'{value}' structurally modifies '{sym}' while '{what}' refers to its storage; [help] take a new view after '{value}', or copy the data before changing '{sym}'")
SWC_DIAG_DEF(sanity_err_context_escape, Error, "'Swag.setContext' stores a pointer to local variable '{sym}' beyond its frame; [help] save the previous context, then restore it with 'defer Swag.setContext(prev)'")
