// This Swag script has been done thanks to "The Coding Train" youtube channel.
// https://www.youtube.com/watch?v=6z7GQewK-Ks&list=PLRqwX-V7Uu6ZiZxtDDRCi6uhfTH4FilpH

#import("gui", location: "swag@std")

using Core, Gui, Pixel

var g_Image:       Image
var g_Texture:     Texture
late var g_Slider: *Slider

func updateFractal()
{
    using Math

    let slider = g_Slider
    var bounds = {minimum: slider.lowerValue(), maximum: slider.upperValue()}
    g_Image.visitPixels(&bounds)
    {
        let parameters = cast(*#decltype(bounds), userData!)
        let minimum    = parameters.minimum
        let maximum    = parameters.maximum

        var real      = map(cast(f32, x), 0, cast(f32, g_Image.width), minimum, maximum)
        var imaginary = map(cast(f32, y), 0, cast(f32, g_Image.height), minimum, maximum)

        // Each pixel fixes the constant; only the iterated value changes.
        let constantReal      = real
        let constantImaginary = imaginary

        var iterations = 0
        const MaxIterations = 100
        while iterations < MaxIterations
        {
            // Keep both old components while applying z squared plus the constant.
            let previousReal      = real
            let previousImaginary = imaginary

            real       = previousReal * previousReal - previousImaginary * previousImaginary
            imaginary  = 2 * previousReal * previousImaginary
            real       += constantReal
            imaginary  += constantImaginary
            iterations += 1
            if real * real + imaginary * imaginary > 4 do
                break
        }

        let brightness = cast(u8, Math.map(cast(f32, iterations), 0, cast(f32, MaxIterations), 0, 255))
        pix[0] = brightness
        pix[1] = brightness
        pix[2] = brightness
    }
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    let width  = cast(s32, wnd.position.width)
    let height = cast(s32, wnd.position.height)

    switch evt
    {
    case CreateEvent:
        with let slider = Slider.create(wnd, {0, 0, 200}, range: true)
        {
            g_Slider = slider
            .setBounds(-2.5, 2.5)
            .setRange(-2.5, 2.5)
            .sigChanged += func|wnd|(_)
            {
                updateFractal()
                wnd.invalidate()
            }
        }

        g_Image   = Image.create(200, 200, .BGR8)
        g_Texture = wnd.app().renderer.addImage(g_Image)

        updateFractal()
        return true

    case PaintEvent as paintEvt:
        let painter = paintEvt.paintContext.painter
        paintEvt.paintContext.renderer.updateTexture(g_Texture, g_Image.pixels.storage())
        painter.drawTexture(0, 0, cast(f32, width), cast(f32, height), g_Texture)
        return true
    }

    return false
}

#main
{
    Swag.setWorkerCount(4)
    Application.runSurface(100, 100, 466, 481, title: "Mandelbrot", hook: &onEvent)
}
