# French strings of the Swag Scope video viewer. A key omitted here keeps its English value.

ui_TipPlay       Lire
ui_TipPause      Mettre en pause
ui_TipStop       Arrêter
ui_TipBackward   Reculer de 10 secondes (Gauche) · Ctrl+Gauche : image précédente
ui_TipForward    Avancer de 10 secondes (Droite) · Ctrl+Droite : image suivante
ui_TipSeek       Rechercher une image
ui_TipFullScreen Plein écran (F)
ui_SubtitleChip  Sous-titres %
cmd_Subtitles    Sous-titres…
cmd_AudioTrack   Piste audio…
cmd_Speed        Vitesse…
ui_TipMute       Couper ou rétablir le son (M)
ui_TipVolume     Volume
ui_OptionSpeed       Vitesse
ui_OptionAudio       Piste audio
ui_OptionSubtitles   Sous-titres
ui_PlayerSpeedNormal  Normale
ui_AudioTrackNumber  Audio %
ui_AudioTrackLang    <p2> (%)</p>
ui_AudioDetails  % · % can. · %{f1} kHz

ui_SubtitleOff             Désactivés
ui_SubtitleTrackNumber     Sous-titres %
ui_SubtitleTrackLang       <p2> (%)</p>
ui_SubtitleEmbedded        Intégrés
ui_SubtitleSidecar         Fichier externe
ui_SubtitleTrack           Piste
ui_SubtitleAppearance      Apparence
ui_SubtitleFont            Police
ui_SubtitleFontSans        Sans empattement système
ui_SubtitleFontMono        Chasse fixe
ui_SubtitleSize            Taille du texte
ui_SubtitleSizeSmall       Petite
ui_SubtitleSizeNormal      Normale
ui_SubtitleSizeLarge       Grande
ui_SubtitleSizeVeryLarge   Très grande
ui_SubtitleEffect          Lisibilité
ui_SubtitleEffectOutline   Contour
ui_SubtitleEffectShadow    Ombre
ui_SubtitleEffectBackdrop  Arrière-plan
ui_SubtitleEffectNone      Aucun
ui_SubtitlePosition        Position
ui_SubtitlePositionBottom  Bas
ui_SubtitlePositionCenter  Centre
ui_SubtitlePositionTop     Haut
ui_SubtitleColor           Couleur du texte
ui_SubtitleColorWhite      Blanc
ui_SubtitleColorYellow     Jaune
ui_SubtitleDelay           Synchronisation
ui_SubtitleDelayReset      Réinitialiser le décalage

word_Frame       image
word_Frames      images

err_AudioTrack  l'index de piste audio dépasse le nombre de pistes de la vidéo
err_AudioEngine impossible de créer le moteur audio de la lecture vidéo
