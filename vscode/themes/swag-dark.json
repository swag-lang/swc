{
	"$schema": "vscode://schemas/color-theme",
	"name": "Swag Dark",
	"colors": {
		"checkbox.border": "#6B6B6B",
		"editor.background": "#1E1E1E",
		"editor.foreground": "#D4D4D4",
		"editor.inactiveSelectionBackground": "#3A3D41",
		"editorIndentGuide.background1": "#404040",
		"editorIndentGuide.activeBackground1": "#707070",
		"editor.selectionHighlightBackground": "#ADD6FF26",
		"list.dropBackground": "#383B3D",
		"activityBarBadge.background": "#007ACC",
		"sideBarTitle.foreground": "#BBBBBB",
		"input.placeholderForeground": "#A6A6A6",
		"menu.background": "#252526",
		"menu.foreground": "#CCCCCC",
		"menu.separatorBackground": "#454545",
		"menu.border": "#454545",
		"menu.selectionBackground": "#0078d4",
		"statusBarItem.remoteForeground": "#FFF",
		"statusBarItem.remoteBackground": "#16825D",
		"ports.iconRunningProcessForeground": "#369432",
		"sideBarSectionHeader.background": "#0000",
		"sideBarSectionHeader.border": "#ccc3",
		"tab.selectedBackground": "#37373D",
		"tab.selectedForeground": "#FFFFFF",
		"tab.lastPinnedBorder": "#ccc3",
		"list.activeSelectionIconForeground": "#FFF",
		"terminal.inactiveSelectionBackground": "#3A3D41",
		"widget.border": "#303031",
		"actionBar.toggledBackground": "#383a49",
		"agentsPanel.border": "#303031",
		"agentsCard.border": "#00000000",
		"agentsChatInput.border": "#303031",
		"agentsChatInput.focusBorder": "#007ACC",
		"agentsNewSessionButton.border": "#303031",
		"surface.border": "#252526",
		"modernActivityBar.activeBackground": "#1E1E1E",
		"modernActivityBar.hoverBackground": "#1E1E1E66",
		"modernActivityBar.background": "#00000000"
	},
	"tokenColors": [
		{
			"scope": "comment",
			"settings": {
				"foreground": "#7AA86A"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#E8A06A"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "keyword.control",
			"settings": {
				"foreground": "#C48FD0"
			}
		},
		{
			"scope": "keyword.declaration",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#D5D5DD"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"entity.name.function.op"
			],
			"settings": {
				"foreground": "#E8A06A"
			}
		},
		{
			"scope": "entity.name.function.intrinsic",
			"settings": {
				"foreground": "#CBB45C"
			}
		},
		{
			"scope": "entity.name.namespace.builtin.swag",
			"settings": {
				"foreground": "#94A3B8"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#FF6666"
			}
		},
		{
			"scope": [
				"meta.preprocessor",
				"entity.name.function.preprocessor"
			],
			"settings": {
				"foreground": "#9A9AA6"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class"
			],
			"settings": {
				"foreground": "#56C2B3"
			}
		},
		{
			"scope": "storage.type",
			"settings": {
				"foreground": "#E0B464"
			}
		},
		{
			"scope": "storage.modifier",
			"settings": {
				"foreground": "#74AAE0"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#9EC98F"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#E0937C"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#CBB45C"
			}
		},
		{
			"scope": "source.code",
			"settings": {
				"foreground": "#D5D5DD"
			}
		}
	]
}
