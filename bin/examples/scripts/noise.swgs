#import("gui", location: "swag@std")
#load("surface.swg")

using Core, Gui, Pixel, Core.Math

var g_Texture: Texture
var g_Image:   Image

const Resolution    = 1024
const SettingsWidth = 320
const Margin        = 20.0

#[Swag.Using(Gui.Properties)]
struct NoiseParams
{
    #[RecalcLayout]
    kind = Noise.FastNoiseKind.Perlin

    seed = 1337

    #[SliderMinMax(0.01, 1), Description("The period in which we sample the noise. A higher frequency results in more frequent noise change")]
    frequency = 0.01

    #[Description("The number of layers of noise. More octaves create a more varied look but are also more resource-intensive to calculate"), MinMax(1, 10), RecalcLayout]
    octaves = 3

    #[SliderMinMax(1.0, 3.0), Description("The rate of change of the frequency for each successive octave. A 'lacunarity' value of 1 results in each octave having the same frequency")]
    lacunarity = 2.0

    #[SliderMinMax(0.01, 0.5), Description("The scaling factor applied to each octave. 'gain' is only used when 'octaves' is set to a value higher than 1.")]
    gain = 0.5
}

impl IPropertyNotify for NoiseParams
{
    mtd impl isItemEnabled(_: *Properties, item: *PropertiesItem)->bool
    {
        let isFractal = .kind != Noise.FastNoiseKind.Perlin and .kind != Noise.FastNoiseKind.Value

        switch item.typeValue.name
        {
        case #nameof(NoiseParams.octaves):    return isFractal
        case #nameof(NoiseParams.lacunarity): return isFractal and .octaves > 1
        case #nameof(NoiseParams.gain):       return isFractal and .octaves > 1
        }

        return true
    }
}

var g_NoiseParams: NoiseParams
var g_Noise:       Noise.FastNoise

func compute()
{
    g_Noise.seed       = g_NoiseParams.seed
    g_Noise.kind       = g_NoiseParams.kind
    g_Noise.frequency  = cast(f32, g_NoiseParams.frequency)
    g_Noise.octaves    = g_NoiseParams.octaves
    g_Noise.lacunarity = cast(f32, g_NoiseParams.lacunarity)
    g_Noise.gain       = cast(f32, g_NoiseParams.gain)
    g_Image.fillNoise(&g_Noise)
}

func createUI(wnd: *Wnd)
{
    with let prop = PropertiesCtrl.create(wnd, {0, 0, SettingsWidth}, .Grid)
    {
        .dockStyle       = .Left
        .margin          = {Margin, Margin, 0, Margin}
        .backgroundStyle = .Window
        .splitter.setPaneVisible(0, false)
        .properties.setEditorWidth(196)
        .properties.setNameColumnWidth(112)
        .properties.addStruct(g_NoiseParams)
        .properties.sigValueChanged += func|wnd|(_, _)
        {
            compute()
            wnd.invalidate()
        }
    }
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case CreateEvent:
        g_Image = Image.create(Resolution, Resolution, .BGR8)
        createUI(wnd)
        compute()

    case PaintEvent as paintEvt:
        let painter  = paintEvt.paintContext.painter
        let renderer = paintEvt.paintContext.renderer

        // A failed upload may leave partial pixels, so replace the texture before drawing.
        if g_Texture.isValid() and not renderer.updateTexture(g_Texture, g_Image.pixels.storage()) do
            renderer.removeTexture(&g_Texture)
        if not g_Texture.isValid() do
            g_Texture = renderer.addImage(g_Image)

        if g_Texture.isValid()
        {
            let client = wnd.clientRect()
            let left   = SettingsWidth + 2 * Margin
            let room   = Math.Rectangle{left, Margin, client.width - left - Margin, client.height - 2 * Margin}
            let dest   = Math.Rectangle.fittedWithin({0, 0, Resolution, Resolution}, room)
            painter.drawTexture(dest, g_Texture)
        }
    }

    return false
}

#main
{
    Swag.startWorkers()

    try runExample(1040, 720, title: "Noise", canSize: false, hook: &onEvent)
}
