//! Format: H.265/HEVC decoder component.
//! Supported: Progressive Main and Main 10 streams: 8- and 10-bit 4:2:0, I/P/B slices, tiles, wavefront parallel processing, dependent slice segments, sample adaptive offset, and in-loop deblocking.
//! Not supported: 4:2:2 and 4:4:4 chroma, bit depths above 10, pulse code modulation blocks, separate colour planes, and the range, multilayer, 3D, and screen content extensions.
//! Role: This file owns normative context initialization, scaling, and prediction tables.
//
#global namespace Hevc
#global internal

// Normative tables of Rec. ITU-T H.265, transcribed from the standard.
//
// Everything here is fixed by the format: a changed value changes what the decoder decodes, so
// each table names the clause it comes from and nothing here is tuned.

// The number of context variables one slice keeps.
const ContextCount = 157'u32

// The offset of each syntax element's context group in the flat context array.
