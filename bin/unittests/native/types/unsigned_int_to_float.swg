#[Swag.NoInline]
func castUnsignedToDouble(value: u64)->f64 => cast(f64) value

#test
{
    let values: [15] u64 = [
        0, 1, 0xFFFFFFFF, 0x100000000,
        0x1FFFFFFFFFFFFF, 0x20000000000000, 0x20000000000001,
        0x20000000000003, 0x20000000000005,
        0x7FFFFFFFFFFFFFFF, 0x8000000000000000,
        0x8000000000000001, 0xFFFFFFFFFFFFF7FF,
        0xFFFFFFFFFFFFFC00, 0xFFFFFFFFFFFFFFFF,
    ]
    let bits: [15] u64 = [
        0, 0x3FF0000000000000, 0x41EFFFFFFFE00000, 0x41F0000000000000,
        0x433FFFFFFFFFFFFF, 0x4340000000000000, 0x4340000000000000,
        0x4340000000000002, 0x4340000000000002,
        0x43E0000000000000, 0x43E0000000000000,
        0x43E0000000000000, 0x43EFFFFFFFFFFFFF,
        0x43F0000000000000, 0x43F0000000000000,
    ]

    for i in values.count do
        Swag.assert(cast #bit (u64) castUnsignedToDouble(values[i]) == bits[i])
}
