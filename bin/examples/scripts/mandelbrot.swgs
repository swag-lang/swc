// This Swag script has been done thanks to "The Coding Train" youtube channel.
// https://www.youtube.com/watch?v=6z7GQewK-Ks&list=PLRqwX-V7Uu6ZiZxtDDRCi6uhfTH4FilpH

#import("gui", location: "swag@std")
#load("surface.swg")

using Core, Gui, Pixel

var g_Image:       Image
var g_Texture:     Texture
late var g_Slider: *Slider

func updateFractal()
{
    using Math

    let slider = g_Slider
    var bounds = {minimum: slider.lowerValue(), maximum: slider.upperValue()}
    g_Image.visitPixels(&bounds)
    {
        let parameters = cast(*#decltype(bounds), unwrap userData)
        let minimum    = parameters.minimum
        let maximum    = parameters.maximum

        let extent        = maximum - minimum
        let realPart      = map(cast(f32, x), 0, cast(f32, g_Image.width), minimum, maximum)
        let imaginaryPart = map(cast(f32, y), 0, cast(f32, g_Image.height), -extent * 0.5, extent * 0.5)

        // Iterate z² + c from zero at every sample.
        var real, imaginary: f32
        var iterations = 0
        const MaxIterations = 100
        while iterations < MaxIterations
        {
            // Keep both old components while applying z squared plus the constant.
            let previousReal      = real
            let previousImaginary = imaginary

            real       = previousReal * previousReal - previousImaginary * previousImaginary
            imaginary  = 2 * previousReal * previousImaginary
            real       += realPart
            imaginary  += imaginaryPart
            iterations += 1
            if real * real + imaginary * imaginary > 4 do
                break
        }

        let brightness = cast(u8, Math.map(cast(f32, iterations), 0, cast(f32, MaxIterations), 0, 255))
        pix[0] = brightness
        pix[1] = brightness
        pix[2] = brightness
    }
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case CreateEvent:
        with let label = Label.create(wnd, "Real axis", {24, 16, 72, 32}, null, .SecondaryText)
        {
            .setTextAlignment(.Left, .Center)
        }

        with let slider = Slider.create(wnd, {104, 16, 260, 32}, range: true)
        {
            g_Slider = slider
            .setBounds(-2.5, 2.5)
            .setRange(-2.1, 1.1)
            .sigChanged += func|wnd|(_)
            {
                updateFractal()
                wnd.invalidate()
            }
        }

        g_Image = Image.create(384, 384, .BGR8)

        updateFractal()
        return true

    case PaintEvent as paintEvt:
        let painter  = paintEvt.paintContext.painter
        let renderer = paintEvt.paintContext.renderer

        // A failed upload may leave partial pixels, so replace the texture before drawing.
        if g_Texture.isValid() and not renderer.updateTexture(g_Texture, g_Image.pixels.storage()) do
            renderer.removeTexture(&g_Texture)
        if not g_Texture.isValid() do
            g_Texture = renderer.addImage(g_Image)

        if g_Texture.isValid()
        {
            let client = wnd.clientRect()
            let room   = Math.Rectangle{24, 64, client.width - 48, client.height - 88}
            if room.width > 0 and room.height > 0
            {
                let dest = Math.Rectangle.fittedWithin({0, 0, g_Image.width, g_Image.height}, room)
                painter.drawTexture(dest, g_Texture)
            }
        }

        return true
    }

    return false
}

#main
{
    Swag.setWorkerCount(4)
    try runExample(510, 550, title: "Mandelbrot", hook: &onEvent)
}
