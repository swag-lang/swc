#import("core", location: "swag@std")

var sequence: u32

#init
{
    Swag.require(sequence == 0)
    sequence = 1
}

#init
{
    Swag.require(sequence == 1)
    sequence = 2
}

#main
{
    Swag.require(sequence == 2)
}

#drop
{
    Swag.require(sequence == 3)
    Swag.print("SWAG_LIFECYCLE_ORDER_RAN\n")
}

#drop
{
    Swag.require(sequence == 2)
    sequence = 3
}
