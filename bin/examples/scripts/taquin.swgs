#import("gui", location: "swag@std")
#load("surface.swg")

using Core, Gui, Pixel

const Side      = 3
const TileCount = Side * Side
const EmptyTile = TileCount - 1
const Margin    = 24.0
const BoardTop  = 68.0
const TileGap   = 6.0

var g_Board:         [TileCount] s32
var g_Empty:         s32
var g_SlideFrom:     s32 = -1
var g_SlideProgress: f32
var g_Texture:       Texture
var g_Source:        Math.Rectangle
late var g_Status:   *Label

func areAdjacent(a, b: s32)->bool
{
    return Math.abs(a % Side - b % Side) + Math.abs(a / Side - b / Side) == 1
}

func shuffle(wnd: *Wnd)
{
    for tile in TileCount do
        g_Board[tile] = tile

    g_Empty     = EmptyTile
    g_SlideFrom = -1
    var previous = -1

    // Legal moves preserve solvability. An odd number of moves cannot return to the solved board.
    for 73
    {
        var neighbors: [4] s32
        var count:     u64
        for tile in TileCount where tile != previous and areAdjacent(tile, g_Empty)
        {
            neighbors[count] = tile
            count += 1
        }

        let next = neighbors[Random.shared().nextU64(0, count)]
        g_Board[g_Empty] = g_Board[next]
        g_Board[next]    = EmptyTile
        previous         = g_Empty
        g_Empty          = next
    }

    g_Status.setText("Slide a tile next to the empty space.")
    wnd.invalidate()
}

func boardRect(wnd: *Wnd)->Math.Rectangle
{
    let client = wnd.clientRect()
    let bounds = Math.Rectangle{Margin, BoardTop, client.width - 2 * Margin, client.height - BoardTop - Margin}
    let extent = Math.max(0, Math.min(bounds.width, bounds.height))
    return {bounds.horzCenter() - extent * 0.5, bounds.vertCenter() - extent * 0.5, extent, extent}
}

func tileRect(board: Math.Rectangle, tile: s32)->Math.Rectangle
{
    let extent = board.width / Side
    return {board.x + (tile % Side) * extent, board.y + (tile / Side) * extent, extent, extent}
}

func slideTile(wnd: *Wnd, position: Math.Point)
{
    if g_SlideFrom >= 0 do
        return

    let board = boardRect(wnd)
    if not board.contains(position) do
        return

    let extent = board.width / Side
    let column = cast(s32, (position.x - board.x) / extent)
    let row    = cast(s32, (position.y - board.y) / extent)
    let tile   = row * Side + column
    if areAdjacent(tile, g_Empty)
    {
        g_SlideFrom     = tile
        g_SlideProgress = 0
        wnd.invalidate()
    }
}

func drawBoard(wnd: *Wnd, painter: *Painter)
{
    if g_SlideFrom >= 0
    {
        g_SlideProgress = Math.min(1, g_SlideProgress + 8 * wnd.app().deltaSeconds())
        if g_SlideProgress >= 1
        {
            g_Board[g_Empty]     = g_Board[g_SlideFrom]
            g_Board[g_SlideFrom] = EmptyTile
            g_Empty              = g_SlideFrom
            g_SlideFrom          = -1

            var solved = true
            for tile, index in g_Board where tile != index do
                solved = false
            if solved do
                g_Status.setText("Puzzle solved.")
        }

        wnd.invalidate()
    }

    let board = boardRect(wnd)
    if board.isEmpty() do
        return

    painter.fillRoundRect(board, 8, 8, wnd.themeColors().view_Bk)
    for tile, index in g_Board where tile != EmptyTile
    {
        var dest = tileRect(board, cast(s32, index))
        if index == g_SlideFrom
        {
            let end = tileRect(board, g_Empty)
            dest.x = Math.lerp(dest.x, end.x, g_SlideProgress)
            dest.y = Math.lerp(dest.y, end.y, g_SlideProgress)
        }

        dest.inflate(-TileGap * 0.5)
        if dest.width > 0 do
            painter.drawTexture(dest, tileRect(g_Source, tile), g_Texture)
    }
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    switch evt
    {
    case CreateEvent:
        with let button = PushButton.create(wnd, "Shuffle", {Margin, 20, 100, 32})
        {
            .sigPressed += func|wnd|(_) { shuffle(wnd) }
        }

        with g_Status = Label.create(wnd, "", {Margin + 116, 20, 300, 32}, null, .SecondaryText)
        {
            .setTextAlignment(.Left, .Center)
        }

        let image = expect Image.decode(".jpg", #include("datas/taquin/lighthouse.jpg"))
        g_Texture = wnd.app().renderer.addImage(image)
        let extent = Math.min(image.width, image.height)
        g_Source = {(image.width - extent) * 0.5, (image.height - extent) * 0.5, extent, extent}
        shuffle(wnd)

    case MouseEvent as mouse where mouse.kind == .Pressed and mouse.button == .Left:
        slideTile(wnd, wnd.surfaceToLocal(mouse.surfacePos))

    case PaintEvent as paint:
        drawBoard(wnd, paint.paintContext.painter)
    }

    return false
}

#main
{
    try runExample(640, 700, title: "Sliding Puzzle", hook: &onEvent)
}
