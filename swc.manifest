<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Declares per-monitor DPI awareness at process creation. The compiler runs GUI programs
     in-process under the JIT, so its own manifest is what decides whether those windows get
     physical pixels or a DWM-stretched (blurry) surface; a runtime opt-in loses that to
     whichever injected DLL claims the process awareness first. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
