#global if #command == Swag.CompilerCommand.Test
#global private

using Swag

#test
{
    @assert(Path.isDirectorySeparator('/'u8))
    @assert(Path.isDirectorySeparator('\\'u8))
    @assert(!Path.isDirectorySeparator('a'u8))

    @assert(Path.isValidPathName("src/tests/core.swg"))
    @assert(Path.isValidPathName("C:/src/tests/core.swg"))
    @assert(Path.isValidPathName("src:tests/core.swg"))
    @assert(!Path.isValidPathName(""))
    @assert(!Path.isValidPathName("\x00"))
    @assert(!Path.isValidPathName("\x1f"))
    @assert(!Path.isValidPathName(#raw """bad"name"""))
    @assert(!Path.isValidPathName("bad<name"))
    @assert(!Path.isValidPathName("bad>name"))
    @assert(!Path.isValidPathName("bad|name"))
    @assert(!Path.isValidPathName("bad*name"))
    @assert(!Path.isValidPathName("bad?name"))

    @assert(Path.isValidFileName("core.swg"))
    @assert(Path.isValidFileName(".gitignore"))
    @assert(Path.isValidFileName("archive.tar.gz"))
    @assert(!Path.isValidFileName(""))
    @assert(!Path.isValidFileName("\x00"))
    @assert(!Path.isValidFileName("\x1f"))
    @assert(!Path.isValidFileName(#raw """bad"name"""))
    @assert(!Path.isValidFileName("bad<name"))
    @assert(!Path.isValidFileName("bad>name"))
    @assert(!Path.isValidFileName("bad|name"))
    @assert(!Path.isValidFileName("bad:name"))
    @assert(!Path.isValidFileName("bad*name"))
    @assert(!Path.isValidFileName("bad?name"))
    @assert(!Path.isValidFileName("src/core.swg"))
    @assert(!Path.isValidFileName(#raw "src\core.swg"))

    @assert(Path.rootLength("core.swg") == 0)
    @assert(Path.rootName("core.swg") == null)
    @assert(!Path.isRooted("core.swg"))
    @assert(Path.rootLength("/src/core.swg") == 1)
    @assert(Path.equals(Path.rootName("/src/core.swg") orelse "", "/"))
    @assert(Path.isRooted("/src/core.swg"))
    @assert(Path.rootLength("C:/src/core.swg") == 3)
    @assert(Path.equals(Path.rootName("C:/src/core.swg") orelse "", "C:/"))
    @assert(Path.isRooted("C:/src/core.swg"))
    @assert(Path.rootLength("C:core.swg") == 2)
    @assert(Path.equals(Path.rootName("C:core.swg") orelse "", "C:"))
    @assert(Path.isRooted("C:core.swg"))
    @assert(Path.rootLength(#raw "\\?\C:\src\core.swg") == @countof(#raw "\\?\C:\"))
    @assert(Path.equals(Path.rootName(#raw "\\?\C:\src\core.swg") orelse "", #raw "\\?\C:\"))
    @assert(Path.isRooted(#raw "\\?\C:\src\core.swg"))
    @assert(Path.rootLength(#raw "\\server\share\src\core.swg") == @countof(#raw "\\server\share\"))
    @assert(Path.equals(Path.rootName(#raw "\\server\share\src\core.swg") orelse "", #raw "\\server\share\"))
    @assert(Path.isRooted(#raw "\\server\share\src\core.swg"))
    @assert(Path.rootLength(#raw "\\?\UNC\server\share\src\core.swg") == @countof(#raw "\\?\UNC\server\share\"))
    @assert(Path.equals(Path.rootName(#raw "\\?\UNC\server\share\src\core.swg") orelse "", #raw "\\?\UNC\server\share\"))
    @assert(Path.isRooted(#raw "\\?\UNC\server\share\src\core.swg"))

    @assert(Path.equals(Path.directoryName("src/tests/core.swg") orelse "", "src/tests"))
    @assert(Path.equals(Path.directoryName("src/tests/") orelse "", "src/tests"))
    @assert(Path.equals(Path.directoryName("src\\tests\\core.swg") orelse "", "src\\tests"))
    @assert(Path.equals(Path.directoryName("C:/src/core.swg") orelse "", "C:/src"))
    @assert(Path.equals(Path.directoryName("C:/src/") orelse "", "C:/src"))
    @assert(Path.directoryName("core.swg") == null)
    @assert(Path.directoryName("/core.swg") == null)
    @assert(Path.directoryName("C:/core.swg") == null)

    @assert(Path.equals(Path.fileName("src/tests/core.swg") orelse "", "core.swg"))
    @assert(Path.equals(Path.fileName("core.swg") orelse "", "core.swg"))
    @assert(Path.equals(Path.fileName("C:/src/core.swg") orelse "", "core.swg"))
    @assert(Path.equals(Path.fileName("src\\tests\\core.swg") orelse "", "core.swg"))
    @assert(Path.equals(Path.fileName("C:core.swg") orelse "", "core.swg"))
    @assert(Path.fileName("src/tests/") == null)
    @assert(Path.fileName("C:/src/") == null)

    @assert(Path.equals(Path.fileNameWithoutExtension("src/tests/core.swg") orelse "", "core"))
    @assert(Path.equals(Path.fileNameWithoutExtension("core.swg") orelse "", "core"))
    @assert(Path.equals(Path.fileNameWithoutExtension("archive.tar.gz") orelse "", "archive.tar"))
    @assert(Path.equals(Path.fileNameWithoutExtension(".gitignore") orelse "", ""))
    @assert(Path.equals(Path.fileNameWithoutExtension("src/.gitignore") orelse "", ""))
    @assert(Path.equals(Path.fileNameWithoutExtension("core") orelse "", "core"))
    @assert(Path.fileNameWithoutExtension("src/tests/") == null)

    @assert(Path.equals(Path.extension("src/tests/core.swg") orelse "", ".swg"))
    @assert(Path.equals(Path.extension("core.swg") orelse "", ".swg"))
    @assert(Path.equals(Path.extension("archive.tar.gz") orelse "", ".gz"))
    @assert(Path.equals(Path.extension(".gitignore") orelse "", ".gitignore"))
    @assert(Path.equals(Path.extension("src/.gitignore") orelse "", ".gitignore"))
    @assert(Path.equals(Path.extension("core.") orelse "", "."))
    @assert(Path.extension("core") == null)
    @assert(Path.extension("src.tests/core") == null)
    @assert(Path.hasExtension("core.swg"))
    @assert(Path.hasExtension("archive.tar.gz"))
    @assert(Path.hasExtension(".gitignore"))
    @assert(Path.hasExtension("core."))
    @assert(!Path.hasExtension("core"))
    @assert(!Path.hasExtension("src.tests/core"))
    @assert(Path.hasExtension("CORE.SWG", ".swg"))
    @assert(Path.hasExtension("core.SWG", ".SwG"))
    @assert(!Path.hasExtension("core.swg", ".txt"))

    @assert(Path.combine("src", "tests", "core.swg") == "src/tests/core.swg")
    @assert(Path.combine("", "src/", "tests", "core.swg") == "src/tests/core.swg")
    @assert(Path.combine("src", "", "", "core.swg") == "src/core.swg")
    @assert(Path.combine("src/", "/core.swg") == "src//core.swg")
    @assert(Path.equals("SRC/Tests/Core.swg", "src/tests/core.swg"))
    @assert(!Path.equals("SRC/Tests/Core.swg", "src/tests/other.swg"))

    var normalized: String = "src\\tests\\core.swg"
    Path.normalize(&normalized)
    @assert(normalized == "src/tests/core.swg")

    normalized = #raw "C:\src\tests\core.swg"
    Path.normalize(&normalized)
    @assert(normalized == "C:/src/tests/core.swg")
}
