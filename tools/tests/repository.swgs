#import("core", location: "swag@std")
#load("../src/tool.swg")

using Core

const SampleStamp  = "2026-09-06 12:00"
const SampleReadme = "| File | Area | Updated |\n| --- | --- | --- |\n| [repo.sample.md](repo.sample.md) | Sample | 2026-09-06 12:00 |\n"

// Run the public audit in a child so expected rejection diagnostics stay captured.
func checkBacklog(root: string, content: string, expectedExit: s32, expectedDiagnostic = "", readme = SampleReadme) fail
{
    discard File.writeAllBytes(Path.combine(root, "backlog", "README.md").toString(), cast(const [..] u8) readme)
    discard File.writeAllBytes(Path.combine(root, "backlog", "repo.sample.md").toString(), cast(const [..] u8) content)

    var arguments: Tool.Arguments
    arguments.add(["--num-cores", "6", #curlocation.fileName!, root])
    let commandLine = Tool.joinArguments(arguments.toSlice())
    let executable  = Env.Process.currentExecutablePath()
    let process     = Env.runProcess(executable.toString(), commandLine.toString())
    Swag.assert(process.exitCode() == expectedExit, process.standardOutput())
    if expectedDiagnostic.count do
        Swag.assert(Utf8.contains(process.standardOutput(), expectedDiagnostic))
}

// One well-formed entry whose stamps match `SampleReadme`, followed by `body`.
func sampleEntry(body: string)->String
{
    return Format.toString("### repo.sample.001 — Sample\n\n- Recorded: %\n%\n", SampleStamp, body)
}

func checkRelated(root: string, related: string, expectedExit: s32) fail
{
    let content    = sampleEntry(related)
    let diagnostic = expectedExit != 0 ? "Related identifier 'repo.sample.002' is not live" : ""
    try checkBacklog(root, content.toString(), expectedExit, diagnostic)
}

#main
{
    let args = Env.arguments()
    if args.count > 1 and args[1] == "--check-capture"
    {
        // A process can print a valid marker before failing. Its output is usable only after
        // a successful exit, and a failure must preserve both streams for the report.
        let fonts = Env.realSpecialDirectory(.Font)
        let shell = Path.combine(Path.directoryName(fonts.toString())!, "System32", "cmd.exe")
        var context: Tool.Context
        context.childEnv = Env.currentEnvironment()
        var success: Tool.Arguments
        success.add(["/d", "/c", "echo CAPTURE_SUCCESS"])
        let output = expect context.captureProgram(shell.toString(), success)
        Swag.assert(output.contains("CAPTURE_SUCCESS"))
        var failure: Tool.Arguments
        failure.add(["/d", "/c", "echo CAPTURE_MARKER& echo CAPTURE_DIAGNOSTIC 1>&2& exit 42"])
        discard catch context.captureProgram(shell.toString(), failure) as err
        Swag.assert(err != null)
        Swag.assert(Utf8.contains(Errors.message(err), "exited with code 42"))
        Console.println("capture failure was detected")
        Env.exit(0)
    }

    if args.count > 1
    {
        var context: Tool.Context
        context.root = String.from(args[1])
        Env.exit(expect Tool.auditBacklog(&context))
    }

    let temporary = Env.getSpecialDirectory(.Temp)
    let name      = Format.toString("swag-backlog-%", Guid64.random())
    let root      = Path.combine(temporary.toString(), name.toString())
    expect Directory.create(root.toString())
    defer discard catch Directory.delete(root.toString(), recurse: true)
    expect Directory.create(Path.combine(root.toString(), "backlog").toString())

    expect checkRelated(root.toString(), "- Related: repo.sample.001.", 0)
    expect checkRelated(root.toString(), "**Related:** repo.sample.001.", 0)
    expect checkRelated(root.toString(), "- Related: repo.sample.002.", 1)
    expect checkRelated(root.toString(), "**Related:** repo.sample.002.", 1)
    expect checkRelated(root.toString(), "- **Related:** repo.sample.002.", 1)
    expect checkRelated(root.toString(), "- Related: repo.sample.001,\n  repo.sample.002.", 1)
    expect checkBacklog(root.toString(), "", 1, "backlog domain has no entries")
    expect checkBacklog(root.toString(), "# Retired domain\n\nAll work is complete.\n", 1, "backlog domain has no entries")

    // Every entry opens with its Recorded stamp. An Updated stamp sits directly under it, says
    // what changed, and never precedes it.
    expect checkBacklog(root.toString(), "### repo.sample.001 — Sample\n\n- Evidence: none.\n", 1, "does not open with '- Recorded: YYYY-MM-DD HH:MM'")
    expect checkBacklog(root.toString(), "### repo.sample.001 — Sample\n\n- Recorded: 2026-09-06\n", 1, "malformed Recorded stamp")
    expect checkBacklog(root.toString(), "### repo.sample.001 — Sample\n\n- Recorded: 2026-13-06 12:00\n", 1, "malformed Recorded stamp")
    expect checkBacklog(root.toString(), sampleEntry("- Updated: 2026-09-06 12:30").toString(), 1, "must say what changed")
    expect checkBacklog(root.toString(), sampleEntry("- Updated: 2026-09-06 11:00 — earlier").toString(), 1, "earlier than the entry's Recorded stamp")
    expect checkBacklog(root.toString(), sampleEntry("- Evidence: none.\n- Updated: 2026-09-06 12:30 — late").toString(), 1, "must directly follow the entry's Recorded stamp")

    // The inventory row carries the file's latest stamp, and rows go from the newest file down.
    let refreshed       = sampleEntry("- Updated: 2026-09-06 12:30 — refreshed the evidence")
    let refreshedReadme = "| File | Area | Updated |\n| --- | --- | --- |\n| [repo.sample.md](repo.sample.md) | Sample | 2026-09-06 12:30 |\n"
    expect checkBacklog(root.toString(), refreshed.toString(), 1, "says 2026-09-06 12:00 but the latest stamp in that file is 2026-09-06 12:30")
    expect checkBacklog(root.toString(), refreshed.toString(), 0, "", refreshedReadme)
    expect checkBacklog(root.toString(), sampleEntry("- Evidence: none.").toString(), 1, "inventory has no row for repo.sample.md", "[Sample](repo.sample.md)\n")
    let other = Path.combine(root.toString(), "backlog", "repo.other.md")
    discard expect File.writeAllBytes(other.toString(), "### repo.other.001 — Other\n\n- Recorded: 2026-09-06 13:00\n")
    let unsortedReadme = "| File | Area | Updated |\n| --- | --- | --- |\n| [repo.sample.md](repo.sample.md) | Sample | 2026-09-06 12:00 |\n| [repo.other.md](repo.other.md) | Other | 2026-09-06 13:00 |\n"
    let sortedReadme   = "| File | Area | Updated |\n| --- | --- | --- |\n| [repo.other.md](repo.other.md) | Other | 2026-09-06 13:00 |\n| [repo.sample.md](repo.sample.md) | Sample | 2026-09-06 12:00 |\n"
    expect checkBacklog(root.toString(), sampleEntry("- Evidence: none.").toString(), 1, "is out of order", unsortedReadme)
    expect checkBacklog(root.toString(), sampleEntry("- Evidence: none.").toString(), 0, "", sortedReadme)
    expect File.delete(other.toString())

    // Inside a file, entries go from the most recently updated down, as one list without '##' groups.
    let older = "### repo.sample.002 — Older\n\n- Recorded: 2026-09-06 11:00\n"
    let newer = sampleEntry("- Evidence: none.")
    expect checkBacklog(root.toString(), Format.toString("%\n%", older, newer).toString(), 1, "more recent than the one above it")
    expect checkBacklog(root.toString(), Format.toString("%\n%", newer, older).toString(), 0)
    expect checkBacklog(root.toString(), Format.toString("%\n## Group\n\n%", newer, older).toString(), 1, "grouped under a '##' heading")
    expect checkBacklog(root.toString(), Format.toString("%\n## Out of scope\n\nNothing else.\n", newer).toString(), 0)

    // A focused tool must reject a configuration sweep it cannot run, rather than silently
    // proving just the default configuration.
    let testsDir = Path.directoryName(#curlocation.fileName)!
    let toolsDir = Path.directoryName(testsDir)!
    var arguments: Tool.Arguments
    arguments.add(["--num-cores", "6", Path.combine(toolsDir, "std.swgs").toString(), "--all-cfg"])
    let commandLine = Tool.joinArguments(arguments.toSlice())
    let executable  = expect Env.Process.currentExecutablePath()
    let parsed      = expect Tool.parseOptions(["test"], ["dm", "test", "--tool-relaunched"])
    Swag.assert(parsed.toolRelaunched)
    Swag.assert(parsed.extra.toSlice().count == 0)
    var relaunched:  Tool.Context
    var noArguments: Array'string
    relaunched.compiler = String.from(executable.toString())
    let sameCompiler = expect Tool.relaunchToolIfNeeded(&relaunched, #curlocation.fileName!, noArguments.toSlice(), true)
    Swag.assert(not sameCompiler.didRun)
    relaunched.compiler = Path.combine(root.toString(), "a-different-compiler.exe")
    discard catch Tool.relaunchToolIfNeeded(&relaunched, #curlocation.fileName!, noArguments.toSlice(), true) as relaunchError
    Swag.assert(relaunchError != null)
    Swag.assert(Utf8.contains(Errors.message(relaunchError), "the relaunched tool is running under"))
    var reportedExecutable = String.from(executable)
    Path.normalize(&reportedExecutable)
    Swag.assert(Utf8.contains(Errors.message(relaunchError), reportedExecutable.toString()))
    Swag.assert(Utf8.contains(Errors.message(relaunchError), "a-different-compiler.exe"))
    let process = expect Env.runProcess(executable.toString(), commandLine.toString())
    Swag.assert(process.exitCode() != 0)
    Swag.assert(Utf8.contains(process.standardOutput(), "'--all-cfg' is supported only by build, tests, and goldens"))

    var captureArguments: Tool.Arguments
    captureArguments.add(["--num-cores", "6", #curlocation.fileName!, "--check-capture"])
    let captureLine = Tool.joinArguments(captureArguments.toSlice())
    let captured    = expect Env.runProcess(executable.toString(), captureLine.toString())
    Swag.assert(captured.exitCode() == 0, captured.standardOutput())
    Swag.assert(Utf8.contains(captured.standardOutput(), "CAPTURE_MARKER"))
    Swag.assert(Utf8.contains(captured.standardOutput(), "CAPTURE_DIAGNOSTIC"))
    Swag.assert(Utf8.contains(captured.standardOutput(), "capture failure was detected"))
    Console.println("repository tooling regression checks passed")
}
