#import("gui", location: "swag@std")

using Core, Gui, Pixel

const GridSize = 60

var g_Grid: [2, GridSize, GridSize] bool
var g_CurrentGeneration: s32

// Where the board sits in the view, and how big one cell is.
//
// The cell is a whole number of pixels, so every grid line lands on one and the lattice stays
// even; a fractional cell rounds two neighbouring lines onto the same pixel and the board grows
// a seam. What the rounding leaves over is split between both sides, which is what keeps the
// board centred: dropped where it falls, it all lands right and bottom and the board reads as
// pushed into a corner.
func boardGeometry(wnd: *Wnd)->{ cell, x, y: f32 }
{
    var result: retval
    let rect = wnd.clientRect()
    result.cell = Math.floor(Math.min(rect.width, rect.height) / GridSize)
    let side = result.cell * GridSize
    result.x = Math.floor((rect.width - side) * 0.5)
    result.y = Math.floor((rect.height - side) * 0.5)
    return result
}

// Finish every next-generation cell before publishing that buffer as the current one.
func advanceGeneration(nextGeneration: s32)
{
    for column in 1 until GridSize - 1
    {
        for row in 1 until GridSize - 1
        {
            // Count the eight neighbors without counting the cell itself.
            var aliveNeighbors = 0
            for offsetX in -1 to 1
            {
                for offsetY in -1 to 1
                {
                    if offsetX == 0 and offsetY == 0 do
                        continue
                    aliveNeighbors += g_Grid[g_CurrentGeneration, column + offsetX, row + offsetY] ? 1 : 0
                }
            }

            // Birth needs three neighbors; a living cell also survives with two.
            let wasAlive = g_Grid[g_CurrentGeneration, column, row]
            g_Grid[nextGeneration, column, row] = aliveNeighbors == 3 or (wasAlive and aliveNeighbors == 2)
        }
    }

    g_CurrentGeneration = nextGeneration
}

func onEvent(wnd: *Wnd, evt: IEvent)->bool
{
    let leftPressed  = wnd.app().mouse.isButtonPressed(.Left)
    let rightPressed = wnd.app().mouse.isButtonPressed(.Right)
    let board        = boardGeometry(wnd)
    let cellSize     = board.cell

    switch evt
    {
    case MouseEvent as mouseEvt where mouseEvt.kind == .Pressed or mouseEvt.kind == .Move:
        if leftPressed or rightPressed
        {
            let pos = wnd.surfaceToLocal(mouseEvt.surfacePos)
            let x   = cast(s32, ((pos.x - board.x) / cellSize))
            let y   = cast(s32, ((pos.y - board.y) / cellSize))
            if x < 1 or x >= GridSize - 1 or y < 1 or y >= GridSize - 1 do
                break
            g_Grid[g_CurrentGeneration, x, y] = leftPressed
        }

        return true

    case CreateEvent:

        // Initial population
        for column in 1 until GridSize - 1
        {
            for row in 1 until GridSize - 1
            {
                g_Grid[g_CurrentGeneration, column, row] = Random.shared().nextBool()
            }
        }

    case PaintEvent as paintEvt:
        let painter        = paintEvt.paintContext.painter
        let nextGeneration = (g_CurrentGeneration + 1) % 2

        // Compute next generation, except if user is painting
        if not leftPressed and not rightPressed
        {
            advanceGeneration(nextGeneration)
        }

        // Paint grid
        painter.clear(Argb.White)
        for column in 1 until GridSize - 1
        {
            let x         = board.x + column * cellSize
            let y         = board.y + column * cellSize
            let boardSpan = cellSize * (GridSize - 2)
            painter.drawRect(board.x + cellSize, y, boardSpan, cellSize, Argb.Black)
            painter.drawRect(x, board.y + cellSize, cellSize, boardSpan, Argb.Black)
        }

        // Paint generation
        for column in 1 to GridSize - 1
        {
            for row in 1 to GridSize - 1
            {
                if g_Grid[g_CurrentGeneration, column, row]
                {
                    let x = board.x + column * cellSize
                    let y = board.y + row * cellSize
                    painter.fillRect(x + 1, y + 1, cellSize - 2, cellSize - 2, Argb.Black)
                }
            }
        }

        wnd.invalidate()
        Threading.Thread.sleep(1'ms)
    }

    return false
}

#main
{
    Application.runSurface(100, 100, 780, 790, title: "Game of Life", hook: &onEvent)
}
