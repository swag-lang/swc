#global private

#assert(1.0 + 2.5 == 3.5)
#assert(1.0_f32 + 2.5_f32 == 3.5_f32)
#assert(1.0_f64 + 2.5_f64 == 3.5_f64)

#assert(1 + 2.5 == 3.5)
#assert(1_u8 + 2.5 == 3.5)
#assert(1_s8 + 2.5 == 3.5)
#assert(1_u16 + 2.5 == 3.5)
#assert(1_s16 + 2.5 == 3.5)
#assert(1_u32 + 2.5 == 3.5)
#assert(1_s32 + 2.5 == 3.5)
#assert(1_u64 + 2.5 == 3.5)
#assert(1_s64 + 2.5 == 3.5)

#assert(1 + 1.0 + 1 == 3.0)
#assert(1_u32 + 1.0 + 1_u32 == 3.0)
#assert(1_s32 + 1.0 + 1_s32 == 3.0)
#assert(1.0_f32 + 1.0_f32 + 1.0_f32 == 3.0_f32)
#assert(1.0_f64 + 1.0_f64 + 1.0_f64 == 3.0_f64)

#assert(2.0 - 1.0 == 1.0)
#assert(2.0_f32 - 1.0_f32 == 1.0_f32)
#assert(2.0_f64 - 1.0_f64 == 1.0_f64)

#assert(1.0 * 2.0 == 2.0)
#assert(1.0_f32 * 2.0_f32 == 2.0_f32)
#assert(1.0_f64 * 2.0_f64 == 2.0_f64)

#assert(2.0 / 1.0 == 2.0)
#assert(2.0_f32 / 1.0_f32 == 2.0_f32)
#assert(2.0_f64 / 1.0_f64 == 2.0_f64)

#assert(-1.0 * -1.0 == 1.0)
#assert(-1.0_f32 * -1.0_f32 == 1.0_f32)
#assert(-1.0_f64 * -1.0_f64 == 1.0_f64)

#assert(1.0 + 1.0 == 2.0)
#assert(0.5 + 0.25 == 0.75)
#assert(2.5 + 0.0 == 2.5)
#assert(1.0_f32 + 1.0_f32 == 2.0_f32)
#assert(0.5_f32 + 0.25_f32 == 0.75_f32)
#assert(2.5_f32 + 0.0_f32 == 2.5_f32)
#assert(1.0_f64 + 1.0_f64 == 2.0_f64)
#assert(0.5_f64 + 0.25_f64 == 0.75_f64)
#assert(2.5_f64 + 0.0_f64 == 2.5_f64)

#assert(2.0 - 1.0 == 1.0)
#assert(1.5 - 0.25 == 1.25)
#assert(0.0 - 2.0 == -2.0)
#assert(2.0_f32 - 1.0_f32 == 1.0_f32)
#assert(1.5_f32 - 0.25_f32 == 1.25_f32)
#assert(0.0_f32 - 2.0_f32 == -2.0_f32)
#assert(2.0_f64 - 1.0_f64 == 1.0_f64)
#assert(1.5_f64 - 0.25_f64 == 1.25_f64)
#assert(0.0_f64 - 2.0_f64 == -2.0_f64)

#assert(2.0 * 2.0 == 4.0)
#assert(0.5 * 4.0 == 2.0)
#assert(-1.5 * 2.0 == -3.0)
#assert(2.0_f32 * 2.0_f32 == 4.0_f32)
#assert(0.5_f32 * 4.0_f32 == 2.0_f32)
#assert(-1.5_f32 * 2.0_f32 == -3.0_f32)
#assert(2.0_f64 * 2.0_f64 == 4.0_f64)
#assert(0.5_f64 * 4.0_f64 == 2.0_f64)
#assert(-1.5_f64 * 2.0_f64 == -3.0_f64)

#assert(4.0 / 2.0 == 2.0)
#assert(1.5 / 0.5 == 3.0)
#assert(-3.0 / 1.5 == -2.0)
#assert(4.0_f32 / 2.0_f32 == 2.0_f32)
#assert(1.5_f32 / 0.5_f32 == 3.0_f32)
#assert(-3.0_f32 / 1.5_f32 == -2.0_f32)
#assert(4.0_f64 / 2.0_f64 == 2.0_f64)
#assert(1.5_f64 / 0.5_f64 == 3.0_f64)
#assert(-3.0_f64 / 1.5_f64 == -2.0_f64)

#assert(0.0 + 0.0 == 0.0)
#assert(-0.0 + 0.0 == 0.0)
#assert(5.0 - 5.0 == 0.0)
#assert(10.0 / 2.0 == 5.0)
#assert(0.0_f32 + 0.0_f32 == 0.0_f32)
#assert(-0.0_f32 + 0.0_f32 == 0.0_f32)
#assert(5.0_f32 - 5.0_f32 == 0.0_f32)
#assert(10.0_f32 / 2.0_f32 == 5.0_f32)
#assert(0.0_f64 + 0.0_f64 == 0.0_f64)
#assert(-0.0_f64 + 0.0_f64 == 0.0_f64)
#assert(5.0_f64 - 5.0_f64 == 0.0_f64)
#assert(10.0_f64 / 2.0_f64 == 5.0_f64)

// Folding follows binary64 and binary32 exactly, as the same sums do at run time: in binary64,
// 0.1 + 0.2 is 0.30000000000000004, one ulp above the double nearest to 0.3.
#assert(0.1 + 0.2 != 0.3)
#assert(0.1_f32 + 0.2_f32 == 0.3_f32)
#assert(0.1_f64 + 0.2_f64 != 0.3_f64)

#assert(1.0 * 1.000000000 == 1.0)
#assert(1.0_f32 * 1.000000000_f32 == 1.0_f32)
#assert(1.0_f64 * 1.000000000_f64 == 1.0_f64)

#assert(1.0 - 1.0 == 0.0)
#assert(1.0 * 0.0 == 0.0)
#assert(1.0 / 1.0 == 1.0)
#assert(-1.0 / 1.0 == -1.0)
#assert(0.0 / 1.0 == 0.0)
#assert(1.0_f32 - 1.0_f32 == 0.0_f32)
#assert(1.0_f32 * 0.0_f32 == 0.0_f32)
#assert(1.0_f32 / 1.0_f32 == 1.0_f32)
#assert(-1.0_f32 / 1.0_f32 == -1.0_f32)
#assert(0.0_f32 / 1.0_f32 == 0.0_f32)
#assert(1.0_f64 - 1.0_f64 == 0.0_f64)
#assert(1.0_f64 * 0.0_f64 == 0.0_f64)
#assert(1.0_f64 / 1.0_f64 == 1.0_f64)
#assert(-1.0_f64 / 1.0_f64 == -1.0_f64)
#assert(0.0_f64 / 1.0_f64 == 0.0_f64)

#assert(1.0_f32 + 2.0_f64 == 3.0)
#assert(1.0_f32 + 2.0_f64 == 3.0_f64)
#assert(1.0_f64 + 2.0_f32 == 3.0)
#assert(1.0_f64 + 2.0_f32 == 3.0_f64)

#assert(0.0 == -0.0)
#assert(0.0_f32 == -0.0_f32)
#assert(0.0_f64 == -0.0_f64)
#assert(-5.0 * 0.0 == 0.0)
#assert(-5.0_f32 * 0.0_f32 == 0.0_f32)
#assert(-5.0_f64 * 0.0_f64 == 0.0_f64)
#assert(0.0 <= -0.0)
#assert(0.0_f32 <= -0.0_f32)
#assert(0.0_f64 <= -0.0_f64)
#assert(-0.0 >= 0.0)
#assert(-0.0_f32 >= 0.0_f32)
#assert(-0.0_f64 >= 0.0_f64)
