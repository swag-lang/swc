#global private

#assert("truetrue" == #stringof("true", "true"))
#assert("truetrue" == #stringof("true", true))
#assert("truefalse" == #stringof("true", false))
#assert("falsetrue" == #stringof(false, "true"))
#assert("falsefalse" == #stringof(false, false))

#assert(#stringof(1, 2) == "12")
#assert(#stringof(1_s32, 2) == "12")
#assert(#stringof(1_s8, 2) == "12")
#assert(#stringof(1_s16, 2) == "12")
#assert(#stringof(1_s64, 2) == "12")
#assert(#stringof(1_u8, 2) == "12")
#assert(#stringof(1_u16, 2) == "12")
#assert(#stringof(1_u32, 2) == "12")
#assert(#stringof(1_u64, 2) == "12")

#assert(#stringof(-1_s32, 0) == "-10")
#assert(#stringof(-1_s8, 0) == "-10")
#assert(#stringof(-1_s16, 0) == "-10")
#assert(#stringof(-1_s64, 0) == "-10")
#assert(#stringof(-1234_s32, 0) == "-12340")
#assert(#stringof(-1234_s64, 0) == "-12340")

#assert(#stringof(0, 0) == "00")
#assert(#stringof(3, 3) == "33")
#assert(#stringof(10, 20) == "1020")
#assert(#stringof(255_u8, 1) == "2551")
#assert(#stringof(65535_u16, 0) == "655350")

#assert(#stringof(1.5645789_f32, 0) == "1.56457890")
#assert(#stringof(1.5645789_f64, 0) == "1.56457890")
#assert(#stringof(0.0_f32, 0) == "00")
#assert(#stringof(0.0_f64, 0) == "00")
#assert(#stringof(-1.0_f32, 0) == "-10")
#assert(#stringof(-1.0_f64, 0) == "-10")

#assert("123" == #stringof(1, "23"))
#assert("false-1" == #stringof(false, -1))
#assert("true-1" == #stringof(true, -1))
#assert(#stringof("A", "B") == "AB")
#assert(#stringof("A", "") == "A")
#assert(#stringof("", "B") == "B")
#assert("1" == #stringof(1, ""))
#assert(#stringof("", "") == "")
#assert(#stringof('a', 'a') == "aa")
#assert(#stringof('A', "") == "A")
#assert(#stringof("", 'Z') == "Z")
#assert(#stringof('😀', '😀') == "😀😀")
