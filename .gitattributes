# Normalize all text files to LF in the repo
* text=auto eol=crlf

# Windows batch files require CRLF
*.bat text eol=crlf

# Linux setup must keep an LF shebang after checkout.
tools/setup.sh text eol=lf
tools/package-linux.py text eol=lf


# Test and application fixtures are byte-exact: a test compares their sizes and hashes
bin/**/datas/** -text
bin/std/modules/video/src/tests/goldens/*.yuv binary
