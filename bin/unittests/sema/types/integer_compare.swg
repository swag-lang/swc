#global private

#assert(12_s8 == 12_s8)
#assert(12_s16 == 12_s16)
#assert(12_s32 == 12_s32)
#assert(12_s64 == 12_s64)

#assert(12_u8 == 12_u8)
#assert(12_u16 == 12_u16)
#assert(12_u32 == 12_u32)
#assert(12_u64 == 12_u64)

#assert(127_s8 == 127_s8)
#assert(255_u8 == 255_u8)
#assert(32767_s16 == 32767_s16)
#assert(65535_u16 == 65535_u16)
#assert(2147483647_s32 == 2147483647_s32)
#assert(4294967295_u32 == 4294967295_u32)
#assert(9223372036854775807_s64 == 9223372036854775807_s64)
#assert(18446744073709551615_u64 == 18446744073709551615_u64)

#assert(-127_s8 == -127_s8)
#assert(-127 == -127)
#assert(-32767_s16 == -32767_s16)
#assert(-2147483647_s32 == -2147483647_s32)
#assert(-9223372036854775807_s64 == -9223372036854775807_s64)

#assert(-128_s8 == -128_s8)
#assert(-32768_s16 == -32768_s16)
#assert(-2147483648_s32 == -2147483648_s32)
#assert(-9223372036854775808_s64 == -9223372036854775808_s64)

#assert(1_s8 == 1)
#assert(1_s16 == 1)
#assert(1_s32 == 1)
#assert(1_s64 == 1)
#assert(1_u8 == 1)
#assert(1_u16 == 1)
#assert(1_u32 == 1)
#assert(1_u64 == 1)

#assert(1_s8 == 1_s16)
#assert(1_s8 == 1_s32)
#assert(1_s8 == 1_s64)
#assert(1_s16 == 1_s32)
#assert(1_s16 == 1_s64)
#assert(1_s32 == 1_s64)

#assert(1_u8 == 1_u16)
#assert(1_u8 == 1_u32)
#assert(1_u8 == 1_u64)
#assert(1_u16 == 1_u32)
#assert(1_u16 == 1_u64)
#assert(1_u32 == 1_u64)

#assert(42 == 42_s8)
#assert(42 == 42_s16)
#assert(42 == 42_s32)
#assert(42 == 42_s64)
#assert(42 == 42_u8)
#assert(42 == 42_u16)
#assert(42 == 42_u32)
#assert(42 == 42_u64)

#assert(10_s8 == 10_u8)
#assert(100_s16 == 100_u16)
#assert(127_s8 == 127_s16)
#assert(255_u8 == 255_u16)
#assert(32767_s16 == 32767_s32)
#assert(65535_u16 == 65535_u32)
#assert(1_s8 == 1_u64)
#assert(0_s8 == 0_u8)
#assert(0_s16 == 0_u16)
#assert(0_s32 == 0_u32)
#assert(0_s64 == 0_u64)

#assert(1 != 2)

#assert(1 < 2)
#assert(1 <= 2)
#assert(1 <= 1)
#assert(2 > 1)
#assert(2 >= 1)
#assert(2 >= 2)

#assert((1 <=> 2) == -1)
#assert((2 <=> 1) == 1)
#assert((1 <=> 1) == 0)

#assert((1_s8 <=> 2) == -1)
#assert((2_s64 <=> 1) == 1)
#assert((1_u32 <=> 1) == 0)

#assert((1_s8 <=> 2_s8) == -1)
#assert((2_s16 <=> 1_s16) == 1)
#assert((1_s32 <=> 1_s32) == 0)
#assert((1_u8 <=> 2_u8) == -1)
#assert((2_u16 <=> 1_u16) == 1)
#assert((1_u64 <=> 1_u64) == 0)

#assert(40000_u16 == 40000_s32)
#assert(200_u8 == 200_s16)

// A negative value has no place in the promoted unsigned type, so the comparison is
// rejected rather than answered on the wrapped value. It used to compare '255 < 0' and
// report false; see 'sema_err_signed_unsigned'. Cast explicitly to state which reading
// is meant.
#assert(cast(s16, -1_s8) != cast(s16, 0_u8))
#assert(cast(s32, -1_s16) != cast(s32, 0_u16))
#assert(cast(s64, -1_s32) != cast(s64, 0_u32))
#assert(-1_s64 != cast(s64, 0_u32))

#assert(-128_s8 < -127_s8)
#assert(-32768_s16 < -32767_s16)
#assert(0_u8 == 0_s8)
#assert(0_u16 == 0_s16)
#assert(0_u32 == 0_s32)
#assert(0_u64 == 0_s64)
#assert(cast(s16, -1_s8) != cast(s16, 1_u8))
#assert((1_s8 <=> -1_s8) == 1)
#assert((-1_s8 <=> 1_s8) == -1)
#assert((0_s8 <=> 0_s8) == 0)
#assert((0_u8 <=> 0_u8) == 0)

#assert(-1_s8 == -1_f32)
#assert(-1.0_f32 == -1)
#assert(-1.0_f64 == -1)
#assert(1.0_f32 == 1)
#assert(1.0_f64 == 1)
#assert(0.0_f32 == 0)
#assert(0.0_f64 == 0)
