#global private

alias Input   = [256] u8
alias Factors = [32] u64
alias Product = [4] u64
alias Mask    = #simd [16] u8
alias Vector  = #simd [2] u64

#[Swag.NoInline]
func foldWhileLive(keep: Vector, result: *Product, input: const *Input, factors: const *Factors, shuffle: Mask)->Vector
{
    Swag.vecCarrylessProductSum16(result, input, factors, shuffle)
    return keep
}

#test
{
    if not Swag.hasCpuFeature(.CarrylessMultiply512)
    {
        return
    }

    // Generated with independent bit-by-bit polynomial multiplication.
    let initial: [260] u8 = [
        0x55, 0x7F, 0xE2, 0xCC, 0xEF, 0x23, 0x70, 0x90, 0x37, 0x65, 0xD2, 0x2F, 0xFA, 0x5B, 0x94, 0x2D,
        0x2F, 0xAC, 0x50, 0x46, 0x8B, 0x62, 0xF5, 0x7E, 0x2D, 0x20, 0x96, 0xEE, 0x8C, 0x51, 0x52, 0xA2,
        0x73, 0xD6, 0x56, 0x0D, 0x78, 0x8F, 0x0A, 0x64, 0xDA, 0x92, 0x83, 0xD7, 0xDD, 0x51, 0xE7, 0x95,
        0xBE, 0x5E, 0x8E, 0x51, 0x13, 0x0C, 0xFF, 0x63, 0xBD, 0x4B, 0xF2, 0xEB, 0xDA, 0x5C, 0x84, 0xF3,
        0xF7, 0xDD, 0x5B, 0xB5, 0x63, 0x71, 0x74, 0x4A, 0xA2, 0x8F, 0x1D, 0x62, 0x39, 0x6A, 0x30, 0x52,
        0x7F, 0xD2, 0xB4, 0x83, 0xC8, 0x3F, 0x3E, 0x5B, 0x6F, 0xAC, 0xD4, 0xCA, 0x9E, 0x64, 0x1E, 0x31,
        0x90, 0x61, 0x25, 0xE9, 0x93, 0x98, 0x1C, 0x06, 0xAD, 0xA0, 0x34, 0xC1, 0xE0, 0x41, 0xDD, 0x0F,
        0xFF, 0xC3, 0x2F, 0x5C, 0x43, 0xFC, 0xB9, 0xB0, 0xF6, 0x1A, 0x80, 0x91, 0xBE, 0x08, 0xD4, 0x84,
        0xF1, 0xAF, 0xEB, 0xEB, 0x28, 0x31, 0xF9, 0xD4, 0x31, 0x67, 0xF7, 0x8D, 0x74, 0x04, 0xD6, 0x7A,
        0x3E, 0x0E, 0xD0, 0x67, 0xC2, 0x0B, 0x57, 0x90, 0xAD, 0x2E, 0x88, 0xD5, 0x4B, 0xD0, 0x24, 0xB6,
        0xB5, 0xA5, 0x06, 0x89, 0x09, 0x54, 0xB7, 0x54, 0xEA, 0xEE, 0x6A, 0x39, 0x9E, 0xFF, 0x4A, 0xFA,
        0x8E, 0x16, 0x3D, 0xD3, 0x1B, 0xCF, 0x28, 0x1F, 0x9E, 0x2E, 0x8F, 0xCF, 0x17, 0x8C, 0xDF, 0xB5,
        0x7D, 0x3F, 0x7D, 0x72, 0x25, 0x58, 0xD6, 0x2F, 0xA8, 0x22, 0x8B, 0xFE, 0x6B, 0xA3, 0x1D, 0x36,
        0xF1, 0x56, 0xF2, 0xE8, 0x0E, 0x44, 0x9F, 0x13, 0xA9, 0xE0, 0x89, 0xBB, 0x1D, 0x7A, 0x76, 0xA6,
        0x9A, 0x5B, 0x9C, 0x3C, 0x9F, 0xEA, 0x61, 0x64, 0x72, 0x47, 0x01, 0xAE, 0x7E, 0xA4, 0x85, 0xA1,
        0xF7, 0xD2, 0xF5, 0x56, 0x1E, 0x44, 0xB3, 0x25, 0xF6, 0x77, 0xC4, 0x50, 0x89, 0x0B, 0x73, 0x9A,
        0xDB, 0x42, 0xC0, 0x3F
    ]
    let shuffle = cast(Mask, [0x95_u8, 0x61, 0x02, 0x6F, 0x86, 0x02, 0x02, 0x28, 0x09, 0xF0, 0x29, 0x51, 0xBD, 0xE0, 0x7A, 0x01])
    let expected: Product = [0x846152B14F38AA50, 0xF2AA0EB885275B71, 0x16F181E8D803DACE, 0x3E40BC9D4A503454]
    let keep = cast(Vector, [0x1234_5678_9ABC_DEF0_u64, 0xFEDC_BA98_7654_3210])

    // Every pointer is unaligned. The result overlaps both source ranges.
    var bytes = initial
    let result = cast(*Product, bytes.buffer + 3)
    let input = cast(const *Input, bytes.buffer + 1)
    let factors = cast(const *Factors, bytes.buffer + 3)
    let retained = foldWhileLive(keep, result, input, factors, shuffle)
    var actual: Product
    Swag.memcpy(cast([*] void, &actual), cast(const [*] void, result), 32)
    for index in 4
    {
        Swag.require(actual[index] == expected[index])
    }
    for index in 260
    {
        if index < 3 or index >= 35
        {
            Swag.require(bytes[index] == initial[index])
        }
    }
    Swag.require(retained[0] == keep[0] and retained[1] == keep[1])
}
