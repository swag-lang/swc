# French strings of the Swag Scope hexadecimal viewer. A key omitted here keeps its English value.
# The reading names a binary format uses for itself are written the same way in French, so
# `ui_FormatHex`, `ui_EndianLittle`, and `ui_EndianBig` are deliberately absent.

ui_ValueWidth    Largeur des valeurs
ui_Width8        8 bits
ui_Width16       16 bits
ui_Width32       32 bits
ui_Width64       64 bits
ui_Representation Représentation des valeurs
ui_FormatUns     Non signé
ui_FormatSigned  Signé
ui_FormatFloat   Flottant
ui_ByteOrder     Ordre des octets
ui_ZoomMenu Zoom…
ui_Empty         Ce fichier est vide.
ui_GoTo          Aller au décalage
ui_Back          Précédent
ui_Forward       Suivant
ui_SetBookmark   Marquer l’offset actuel
ui_GoToBookmark  Aller à l’offset marqué (%)
ui_SetBaseAddress Choisir l’adresse de base
ui_BaseAddressMessage Adresse virtuelle hexadécimale ou décimale 0d ; saisir zéro pour la désactiver.
ui_GoToMessage   Hexadécimal, décimal 0d, pourcentage, caret, filesize, bookmark ou base ; opérateurs +, -, *, /, parenthèses, align(valeur, limite). Un signe initial part du caret.
ui_SelectAll     Tout sélectionner
ui_RowWidth      Octets par ligne
ui_RowAuto       Ajuster à la fenêtre
ui_SearchPlaceholder  Hexa, text:, value: ou selection:
ui_SearchHelp         Utilisez selection: pour limiter la recherche aux octets sélectionnés ; ajoutez hex:, text: ou value: pour choisir le motif. ? remplace un demi-octet.
ui_SearchSelectionRequired Sélectionnez des octets avant d’utiliser selection:
ui_SearchPatternError Utilisez des paires hexadécimales avec les jokers ??, ?A ou A?.
ui_SearchValueError   Saisissez une valeur adaptée à la largeur et à la représentation actives.
ui_InspectorAt        % à 0x%
ui_DetailsCaret       %{f1}%% · valeur % · caret %/%
ui_DetailsSelection   %{f1}%% · valeur % · sél. %–% (%–%) · long. %/% · caret %/%

ui_Analysis             Analyse
ui_AnalysisTip          Analyser la sélection, ou le fichier entier lorsqu’aucune sélection n’est active
ui_AnalysisRun          Analyser la sélection actuelle, ou le fichier entier lorsqu’aucune sélection n’est active
ui_AnalysisCancel       Arrêter l’analyse
ui_AnalysisClose        Fermer l’analyse
ui_AnalysisAlgorithms   Algorithmes de somme
ui_AnalysisCrc32        CRC-32
ui_AnalysisCrc64        CRC-64/ECMA-182
ui_AnalysisMd5          MD5
ui_AnalysisSha1         SHA-1
ui_AnalysisSha256       SHA-256
ui_AnalysisSha512       SHA-512
ui_AnalysisBlake2s      BLAKE2s-256
ui_AnalysisBlake2b      BLAKE2b-512
ui_AnalysisFile         Fichier entier · %
ui_AnalysisSelection    Sélection @% · %
ui_AnalysisProgress     Analyse · %{f1}%%
ui_AnalysisCancelled    Arrêt après %
ui_AnalysisMetrics      Entropie %{f2}/8 · zéro %{f1}%% · imprimable %{f1}%%
ui_AnalysisEntropyBlocks Entropie par bloc · sélectionner un bloc pour examiner ses octets
ui_AnalysisEntropy      Bits/octet
ui_AnalysisFindings       Chaînes · répétitions de 64 Kio
ui_AnalysisRepeatedBlockKind Bloc
ui_AnalysisRepeatDetail À %
ui_AnalysisRepeatLimited Résultats · limite des répétitions atteinte
ui_AnalysisRepeatLimitsTip Au plus 256 blocs distincts et 256 paires répétées sont conservés.
ui_AnalysisNoBytes      Aucun octet analysé
ui_AnalysisDigests      Sommes calculées : %
ui_AnalysisCopyCrc32     Copier le CRC-32 avec sa plage d’octets
ui_AnalysisCopyCrc64     Copier le CRC-64 avec sa plage d’octets
ui_AnalysisCopySha256   Copier le SHA-256 avec sa plage d’octets
ui_AnalysisCopySha512   Copier le SHA-512 avec sa plage d’octets
ui_AnalysisCopyBlake2s  Copier le BLAKE2s-256 avec sa plage d’octets
ui_AnalysisCopyBlake2b  Copier le BLAKE2b-512 avec sa plage d’octets
ui_AnalysisCopyMd5      Copier le MD5 avec sa plage d’octets
ui_AnalysisCopySha1     Copier le SHA-1 avec sa plage d’octets
ui_AnalysisByteHint     Survolez la carte pour voir le compte exact
ui_AnalysisByte         Octet %{X02} · % occurrences · %{f2}%%
ui_AnalysisByteOnce     Octet %{X02} · 1 occurrence · %{f2}%%
ui_AnalysisStrings      Chaînes inférées
ui_AnalysisStringsCount % chaînes inférées
ui_AnalysisOneString    1 chaîne inférée
ui_AnalysisStringsLimited Premières % chaînes inférées · limite de résultats atteinte
ui_AnalysisAscii        ASCII
ui_AnalysisUtf16Little  UTF-16 LE
ui_AnalysisUtf16Big     UTF-16 BE
ui_AnalysisOffset       Décalage
ui_AnalysisType         Type
ui_AnalysisDetails      Détails
ui_AnalysisEncoding     Encodage
ui_AnalysisText         Texte
err_AnalysisShortRead   Le fichier se termine avant la plage d’analyse

ui_CopyBytes     Copier les octets
ui_CopyText      Copier le texte
ui_CopyDump      Copier le dump
ui_CopyFormats   Autres formats de copie
ui_CopyOffset    Copier le décalage %

ui_CopyBytesMax  Copier les % premiers en octets
ui_CopyTextMax   Copier les % premiers en texte
ui_CopyDumpMax   Copier les % premiers en dump

err_Read      impossible de lire le fichier
err_Truncated le fichier s'arrête avant la taille annoncée
