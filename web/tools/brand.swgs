/**
Generates every Swag brand asset from one geometric definition.

The identity is machined: the mark is cut from a grid of 100 units, in one accent over
one ink, and every corner it opens on is cut at 45 degrees. Nothing here is drawn by
hand, so the mark, the favicon and the application icon can never drift apart. Run it
from the repository root:

    swc web/tools/brand.swgs

It writes the vector master and its raster derivatives into 'web/'. The shape is built
once as a [[Pixel.LinePath]] and handed to the two writers that consume it:
[[Pixel.Svg.Document]] for the vector masters and [[Pixel.Image.fillPath]] for the
rasters, so a file can never disagree with the others about where an edge is.
*/
#dependencies
{
    #import("pixel", location: "swag@std")
}

using Core, Pixel

// #########################################################
// Design grid
// #########################################################

/**
The mark is cut from a square of `GRID` units. Every measurement is a whole number of
units, so the form stays aligned at any size.

The three bars and the two counters fill the height exactly: `3 * STROKE + 2 * GAP`
is `GRID`. Changing one of them means changing another.
*/
const GRID:     f32 = 100.0     // Height of the mark.
const WIDTH:    f32 = 84.0      // Width of the mark, before the lean.
const STROKE:   f32 = 22.0      // Thickness of a bar and of a stem.
const GAP:      f32 = 17.0      // Height of a counter.
const SHOULDER: f32 = 22.0      // The two cuts that open the form; they make it an S.
const TERMINAL: f32 = 12.0      // The two cuts that close a free end.
const LEAN:     f32 = 0.16      // Horizontal shift per unit of height: the mark leans right.

const VOLTAGE = Color.fromRgb(0xF7, 0xF9, 0x00)     // The one accent.
const INK     = Color.fromRgb(0x0B, 0x0B, 0x0D)     // The one ground.

// Width of the mark once leaned, in design units.
const MARK_WIDTH = WIDTH + GRID * LEAN

// #########################################################
// The mark
// #########################################################

/**
Builds the mark: a three-bar `S` cut out of a block.

Two opposite corners are opened by a wide `SHOULDER` cut, which is what separates the
form from a seven-segment `5`; the two free ends are closed by a narrow `TERMINAL` cut.
Those four diagonals are the signature of the whole identity, and the interface repeats
them on the elements it wants to mark as Swag's own.

The path is emitted in device space: `scale` maps the design grid onto the canvas, and
the lean is applied on the way.
*/
func buildMark(scale, originX, originY: f32)->LinePath
{
    let w  = WIDTH
    let s  = STROKE
    let m0 = s + GAP              // Top of the middle bar.
    let m1 = m0 + s               // Bottom of the middle bar.
    let b0 = GRID - s             // Top of the bottom bar.

    let corners: [16] Math.Point = [
        {SHOULDER, 0},                    // Opened top-left shoulder.
        {w - TERMINAL, 0},
        {w, TERMINAL},                    // Cut top-right terminal.
        {w, s},
        {s, s},
        {s, m0},
        {w, m0},
        {w, GRID - SHOULDER},
        {w - SHOULDER, GRID},             // Opened bottom-right shoulder.
        {TERMINAL, GRID},
        {0, GRID - TERMINAL},             // Cut bottom-left terminal.
        {0, b0},
        {w - s, b0},
        {w - s, m1},
        {0, m1},
        {0, SHOULDER}]

    var result: retval
    for &corner, [i] in corners
    {
        // The lean shifts a point right in proportion to how high it sits.
        let x = originX + (corner.x + (GRID - corner.y) * LEAN) * scale
        let y = originY + corner.y * scale
        if i == 0 do
            result.start(x, y)
        else do
            result.lineTo(x, y)
    }

    result.close()
    return result
}

// Centers the mark on a square field: the form every icon uses.
func buildTileMark(size: f32)->LinePath
{
    let scale = size * 0.56 / GRID
    return buildMark(scale, (size - MARK_WIDTH * scale) * 0.5, (size - GRID * scale) * 0.5)
}

// #########################################################
// Assets
// #########################################################

// The mark alone, on nothing: the master every placement starts from.
func writeMark(svgPath, pngPath: string, size: s32) fail
{
    const MARGIN = 8'f32
    let boxWidth  = MARK_WIDTH + MARGIN * 2
    let boxHeight = GRID + MARGIN * 2

    var doc = Svg.Document.create(boxWidth, boxHeight)
    doc.setTitle("Swag")
    doc.addPath(buildMark(1, MARGIN, MARGIN), VOLTAGE)
    try doc.save(svgPath)
    wrote(svgPath)

    let scale = cast(f32) size / boxHeight
    var img   = Image.create(cast(s32) (boxWidth * scale), size, .RGBA8)
    img.clear()
    img.fillPath(buildMark(scale, MARGIN * scale, MARGIN * scale), VOLTAGE)
    try img.save(pngPath)
    wrote(pngPath)
}

// The mark on a square field of ink, at one size.
func renderIcon(size: s32)->Image
{
    var result = Image.create(size, size, .RGBA8)
    result.fill(INK)
    result.fillPath(buildTileMark(cast(f32) size), VOLTAGE)
    return result
}

func writeIcon(path: string, size: s32) fail
{
    var img = renderIcon(size)
    try img.save(path)
    wrote(path)
}

// The favicon, as a vector and as an icon carrying every size a browser asks for.
//
// Each entry is cut at its own size rather than downsampled from a larger one, so the
// counters of the mark stay open even at 16 pixels.
func writeFavicon(svgPath, icoPath: string) fail
{
    const BOX = 100'f32

    var doc = Svg.Document.create(BOX, BOX)
    doc.setTitle("Swag")
    doc.setBackground(INK)
    doc.addPath(buildTileMark(BOX), VOLTAGE)
    try doc.save(svgPath)
    wrote(svgPath)

    let entries: [3] Image = [renderIcon(16), renderIcon(32), renderIcon(48)]
    try Ico.save(icoPath, entries)
    wrote(icoPath)
}

// Reports one generated file, in the compiler's own step voice.
func wrote(path: string)
{
    @print("  ✓  brand       ", path, "\n")
}

#main
{
    const ROOT = "web"

    @print("  ◆  swag        brand • cutting\n")

    catch
    {
        try writeMark(Path.combine(ROOT, "imgs/swag_mark.svg"), Path.combine(ROOT, "imgs/swag_mark.png"), 512)
        try writeIcon(Path.combine(ROOT, "imgs/swag_icon.png"), 256)
        try writeFavicon(Path.combine(ROOT, "favicon.svg"), Path.combine(ROOT, "favicon.ico"))
    }
    as err

    if err != null
    {
        @print("  ✖  brand       ", err, "\n")
        return
    }

    @print("  ✓  brand       done\n")
}
