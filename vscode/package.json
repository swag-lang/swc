{
  "name": "swag",
  "displayName": "Swag",
  "description": "Syntax highlighting and a dark theme for the Swag programming language",
  "version": "0.0.178",
  "publisher": "swag-lang",
  "icon": "images/swag_icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swag-lang/swc"
  },
  "vsce": {
    "baseImagesUrl": "https://github.com/swag-lang/swc/raw/HEAD/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "scripts": {
    "test": "node --test tests"
  },
  "contributes": {
    "themes": [
      {
        "label": "Swag Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/swag-dark.json"
      }
    ],
    "languages": [
      {
        "id": "swag",
        "aliases": [
          "swag"
        ],
        "extensions": [
          ".swg",
          ".swgs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swag",
        "scopeName": "source",
        "path": "./syntaxes/swag.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
