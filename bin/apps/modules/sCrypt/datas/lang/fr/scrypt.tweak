# French strings of sCrypt. A key omitted here keeps its English value.

ui_WindowTitle         sCrypt — Disques virtuels privés

ui_Subtitle            Un stockage chiffré qui se présente et se comporte comme un disque Windows ordinaire.
ui_CreateCardTitle     Créer un nouveau coffre
ui_CreateCardHelp      Choisissez une capacité fixe. Le conteneur complet est randomisé avant d'être prêt.
ui_MountCardTitle      Ouvrir un coffre existant
ui_MountCardHelp       Déverrouillez un conteneur et exposez-le sur une lettre de lecteur disponible. Agrandir le coffre et changer son mot de passe demandent ce même mot de passe.
ui_MountedCardTitle    Lecteurs montés
ui_MountedCardHelp     Tous les lecteurs actuellement exposés par sCrypt. Cochez-en un pour qu'il soit remonté au prochain démarrage de sCrypt.
ui_CreateTab           Créer
ui_OpenTab             Ouvrir
ui_MountedTab          Montés
ui_NoDriveMounted      Aucun lecteur monté.
ui_ContainerFile       FICHIER CONTENEUR
ui_Browse              Parcourir
ui_FixedCapacity       CAPACITÉ FIXE
ui_NewCapacity         NOUVELLE CAPACITÉ
ui_Password            MOT DE PASSE
ui_CurrentPassword     MOT DE PASSE ACTUEL
ui_CurrentPasswordHelp Le coffre ne change que pour qui peut déjà l'ouvrir.
ui_NewPassword         NOUVEAU MOT DE PASSE
ui_ConfirmPassword     CONFIRMER LE MOT DE PASSE
ui_OptionalPassword    Facultatif — laissez vide pour aucun
ui_EnterAgain          Saisissez à nouveau le mot de passe
ui_ContainerPassword   Vide si le coffre n'en a pas
ui_ExistingContainer   Conteneur chiffré
ui_DriveLetter         LETTRE DE LECTEUR
ui_DriveHelp           Le lecteur est disponible pour Windows tant que sCrypt s'exécute, et apparaît sous Montés.
ui_ReadOnly            Monter en lecture seule
ui_ReadOnlyHelp        Le lecteur s'ouvre en lecture seule : rien ne peut ajouter au coffre, le modifier ni en supprimer tant qu'il est monté.
ui_RemovePasswordHelp  Laissez vide pour supprimer le mot de passe. Le coffre s'ouvrira alors sans mot de passe.
ui_CurrentCapacityHelp Actuellement %. Un coffre ne peut que grandir.
ui_CreateVault         Créer le coffre chiffré
ui_StopCreating        Arrêter la création
ui_StopGrowing         Arrêter l'agrandissement
ui_ChangePassword      Mot de passe…
ui_Resize              Capacité…
ui_MountDrive          Monter
ui_Unmount             Démonter
ui_ColStartup          AU DÉMARRAGE
ui_ColDrive            LECTEUR
ui_ColSize             TAILLE
ui_ColAvailable        DISPONIBLE
ui_ColVault            COFFRE
ui_Desktop             Bureau
ui_LanguageSystem      Langue du système
dlg_TitleCreate        Créer un conteneur sCrypt
dlg_TitleOpen          Ouvrir un conteneur chiffré
dlg_TitlePassword      Changer le mot de passe du coffre
dlg_TitleResize        Agrandir le coffre
dlg_TitleUnlock        Déverrouiller %
dlg_BtnCreate          Créer
dlg_BtnOpen            Ouvrir
dlg_BtnApply           Appliquer
dlg_BtnGrow            Agrandir
dlg_BtnSkip            Ignorer
msg_Ready              Prêt — créez un coffre ou choisissez-en un à ouvrir.
msg_OperationStopped   L'opération s'est arrêtée.
msg_SystemError        Erreur système.
msg_SizeInvalid        La taille du conteneur n'est pas valide.
msg_SizeTooLarge       La taille du conteneur est trop grande.
msg_SizeMinimum        La taille minimale du conteneur est de % MiB.
msg_ChooseCreateFile   Choisissez le fichier conteneur à créer.
msg_FileExists         Ce fichier existe déjà. Choisissez un autre nom pour éviter toute perte de données.
msg_PasswordRequired   Un mot de passe est requis.
msg_PasswordMismatch   Les mots de passe ne correspondent pas.
msg_CreateFailed       Impossible de créer le conteneur.
msg_Randomizing        Création et randomisation du conteneur... %{#0} %%
msg_StopRequested      Arrêt en cours...
msg_CreateCanceled     Création du conteneur annulée. Rien n'a été laissé sur le disque.
msg_ChooseExisting     Choisissez un conteneur existant.
msg_AlreadyMounted     Un lecteur expose déjà ce conteneur.
msg_UnmountFirst       Ce coffre est monté. Démontez-le avant de le modifier.
msg_NoDriveLetter      Aucune lettre de lecteur n'est disponible.
msg_StartingDriver     Démarrage du pilote de système de fichiers portable...
msg_Unmounting         Synchronisation et démontage du lecteur chiffré...
msg_CreateStopped      La création du conteneur s'est arrêtée.
msg_Created            Conteneur créé. Il est prêt à être ouvert.
msg_MountFailed        Impossible de monter le disque virtuel.
msg_MountStopped       Le montage s'est arrêté.
msg_Mounted            Lecteur chiffré monté sur %.
msg_MountedReadOnly    Lecteur chiffré monté en lecture seule sur %.
msg_UnmountSyncStopped Le lecteur a été démonté, mais la synchronisation finale s'est arrêtée.
msg_Unmounted          Lecteur démonté en toute sécurité.
msg_OnlyGrows          Un coffre ne peut que grandir. Choisissez une capacité supérieure à l'actuelle.
msg_Growing            Randomisation de l'espace ajouté... %{#0} %%
msg_GrowCanceled       Agrandissement arrêté. Le coffre a conservé sa taille précédente.
msg_GrowStopped        L'agrandissement s'est arrêté.
msg_GrowFailed         Impossible d'agrandir le conteneur.
msg_Grown              Le coffre contient désormais %.
msg_ChangingPassword   Réécriture de l'emplacement de clé...
msg_PasswordChanged    Le coffre s'ouvre désormais avec le nouveau mot de passe.
msg_PasswordRemoved    Le mot de passe a été supprimé. Le coffre s'ouvre désormais sans mot de passe.
msg_PasswordFailed     Impossible de changer le mot de passe.
msg_PasswordStopped    Le changement de mot de passe s'est arrêté.

# Sentences a failure shows, one per ErrorKind.
msg_ErrPasswordOrDamaged Le mot de passe est incorrect ou le conteneur est endommagé.
msg_ErrDamaged           Le conteneur est endommagé.
msg_ErrNotFound          Le conteneur est introuvable.
msg_ErrAlreadyExists     Un fichier portant ce nom existe déjà.
msg_ErrAccessDenied      L'accès au conteneur a été refusé.
msg_ErrReadOnly          Le coffre est monté en lecture seule.
msg_ErrDiskFull          Il n'y a plus de place dans le conteneur.
msg_ErrIo                Le conteneur n'a pas pu être lu ou écrit.
msg_ErrInvalidRequest    Le conteneur ne peut pas répondre à cette demande.
